---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PRODUCTS, getProductBySlug } from '../../data/products';
import { BRAND_CONFIG } from '../../data/brand';
import HoodieMockup from '../../components/HoodieMockup.astro';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { slug } = Astro.params;
const product = Astro.props.product || getProductBySlug(slug as string);

if (!product) {
  return Astro.redirect('/shop');
}
---

<BaseLayout
  title={`${product.title} - ${BRAND_CONFIG.name}`}
  description={product.description}
  image={product.images.primary}
>
  <!-- Breadcrumb Navigation with Neo-Brutalist Pills -->
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-4" aria-label="Breadcrumb">
    <ol class="flex items-center space-x-2 text-xs font-bold text-ink">
      <li>
        <a href="/" class="hover:text-rust underline decoration-2 decoration-rust">Home</a>
      </li>
      <li>/</li>
      <li>
        <a href="/shop#collection" class="hover:text-rust underline decoration-2 decoration-rust">Drop 01</a>
      </li>
      <li>/</li>
      <li class="px-2 py-0.5 bg-card-vanilla border border-ink rounded-md truncate max-w-[200px]" aria-current="page">
        {product.title}
      </li>
    </ol>
  </nav>

  <!-- Product Detail Section -->
  <article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      
      <!-- Left: Mockup & Detail Showcase (No stock flat-lays) -->
      <div class="lg:col-span-7 space-y-6">
        <div class="bg-card-vanilla border-2 border-ink rounded-3xl p-6 sm:p-8 shadow-brutal-lg relative overflow-hidden">
          {product.badge && (
            <span class="absolute top-6 left-6 z-20 px-3.5 py-1 bg-mint text-ink text-xs font-display font-bold uppercase tracking-wider rounded-xl border-2 border-ink shadow-brutal-sm transform -rotate-3">
              {product.badge}
            </span>
          )}

          <!-- Clean Product Mockup Slot -->
          <div class="w-full">
            <HoodieMockup
              color={product.colors[0].slug === 'espresso' || product.colors[0].slug === 'onyx' ? '#1A1614' : product.colors[0].slug === 'sand' || product.colors[0].slug === 'bone' ? '#FFFDF7' : product.colors[0].slug === 'sage' ? '#52B788' : '#E06D3B'}
              label={product.specs.weight}
              badge="Drop 01 Essential"
              hoodieColorName={product.colors[0].name}
              class="h-[420px] sm:h-[500px]"
            />
          </div>
        </div>

        <!-- Fun Feature Highlights -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-card-vanilla border-2 border-ink rounded-2xl p-5 shadow-brutal">
            <span class="text-xs font-display font-bold uppercase tracking-wider text-rust mb-1 block">
              🐾 Clumsy Paw Tested
            </span>
            <h4 class="text-sm font-display font-bold text-ink mb-1">
              Reinforced Bar-Tack Seams
            </h4>
            <p class="text-xs text-ink-light font-medium leading-relaxed">
              Engineered with heavy-duty twin-needle stitching to survive 40kg dogs pawing at the front pocket for biscuits.
            </p>
          </div>

          <div class="bg-card-vanilla border-2 border-ink rounded-2xl p-5 shadow-brutal">
            <span class="text-xs font-display font-bold uppercase tracking-wider text-mint-dark mb-1 block">
              ✨ Fur & Slobber Shield
            </span>
            <h4 class="text-sm font-display font-bold text-ink mb-1">
              Loopback Organic Cotton
            </h4>
            <p class="text-xs text-ink-light font-medium leading-relaxed">
              Tightly combed cotton loopback fleece that lets fur brush right off without digging into the weave.
            </p>
          </div>
        </div>
      </div>

      <!-- Right: Product Selector & Checkout Form -->
      <div class="lg:col-span-5 bg-card-vanilla border-2 border-ink rounded-3xl p-6 sm:p-8 shadow-brutal-lg space-y-6">
        
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="px-2.5 py-0.5 bg-mint text-ink text-xs font-display font-bold rounded-md border border-ink shadow-brutal-sm">
              {product.specs.weight}
            </span>
            <span class="text-xs font-mono font-bold text-ink-light">
              {product.sku}
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl font-display font-bold text-ink tracking-tight mb-2">
            {product.title}
          </h1>

          <p class="text-xs sm:text-sm text-ink-light font-medium mb-4 leading-relaxed">
            {product.subtitle}
          </p>

          <div class="flex items-baseline space-x-3 pb-4 border-b-2 border-ink">
            <span class="text-3xl font-display font-bold text-ink">
              £{product.price}.00
            </span>
            <span class="text-xs text-ink-light font-bold">
              GBP &bull; Free UK Shipping over £70
            </span>
          </div>
        </div>

        <!-- Relatable Goofy Quote Sticker -->
        {product.goofyQuote && (
          <div class="p-4 bg-canvas-butter/40 rounded-2xl border-2 border-ink shadow-brutal-sm text-xs font-bold text-ink flex items-start gap-2.5">
            <span class="text-lg">🐕</span>
            <div>
              <span class="font-display font-bold block mb-0.5 text-rust uppercase text-[11px]">The Big Dog Reality:</span>
              {product.goofyQuote}
            </div>
          </div>
        )}

        <!-- Small-Batch UK Hand-Inspection Notice -->
        <div class="p-4 bg-periwinkle/30 border-2 border-ink rounded-2xl text-xs text-ink space-y-1 shadow-brutal-sm">
          <div class="flex items-center gap-1.5 font-display font-bold text-rust">
            <span>⏳</span>
            <span>UK Small-Batch Hand Inspection</span>
          </div>
          <p class="text-ink-light font-medium leading-relaxed">
            Every garment is printed in small batches and hand-checked in Leicester, UK before dispatch (5–7 working days) so prints and seams are 100% spot-on.
          </p>
        </div>

        <!-- Interactive Form -->
        <form
          action="/api/checkout"
          method="POST"
          id="checkout-form"
          class="space-y-6"
        >
          <!-- Hidden inputs required for Stripe session generation -->
          <input type="hidden" name="productId" value={product.id} />
          <input type="hidden" name="sku" value={product.sku} />

          <!-- Colorway Selector -->
          <fieldset class="space-y-2">
            <legend class="text-xs font-display font-bold uppercase tracking-wider text-ink">
              Choose Colorway: <span id="selected-color-label" class="text-rust">{product.colors[0].name}</span>
            </legend>
            <div class="flex items-center space-x-3" role="radiogroup" aria-label="Available Colorways">
              {product.colors.map((color, idx) => (
                <label class="relative cursor-pointer group">
                  <input
                    type="radio"
                    name="color"
                    value={color.name}
                    checked={idx === 0}
                    class="sr-only peer"
                    data-color-name={color.name}
                  />
                  <span
                    class="block w-9 h-9 rounded-full border-2 border-ink shadow-brutal-sm peer-checked:ring-2 peer-checked:ring-rust peer-checked:translate-x-[1px] peer-checked:translate-y-[1px] peer-checked:shadow-none transition-all"
                    style={`background-color: ${color.hex}`}
                    title={color.name}
                  ></span>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Size Selector -->
          <fieldset class="space-y-2">
            <div class="flex justify-between items-center">
              <legend class="text-xs font-display font-bold uppercase tracking-wider text-ink">
                Select Size (UK Standard S–XXL)
              </legend>
              <a href="/shop#fit-guide" class="text-xs font-bold text-rust underline">
                Lapdog Fit Guide
              </a>
            </div>
            
            <div class="grid grid-cols-5 gap-2">
              {product.sizes.map((size, idx) => (
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="size"
                    value={size}
                    checked={idx === 1}
                    class="sr-only peer"
                  />
                  <div class="py-2.5 text-center border-2 border-ink bg-card-vanilla rounded-xl text-xs font-display font-bold text-ink shadow-brutal-sm peer-checked:border-ink peer-checked:bg-rust peer-checked:text-card-vanilla peer-checked:translate-x-[2px] peer-checked:translate-y-[2px] peer-checked:shadow-none transition-all">
                    {size}
                  </div>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Buy Now CTA -->
          <div class="pt-2">
            <button
              type="submit"
              id="submit-button"
              class="w-full py-4 px-6 bg-rust hover:bg-rust-dark text-card-vanilla font-display font-bold text-sm uppercase tracking-wider rounded-2xl border-2 border-ink shadow-brutal hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-brutal-hover active:translate-x-[4px] active:translate-y-[4px] active:shadow-none transition-all flex items-center justify-center space-x-2"
            >
              <span>Instant UK Stripe Checkout &bull; £{product.price}.00</span>
              <span class="text-lg">🐾</span>
            </button>
            <p class="text-center text-[11px] font-bold text-ink-light mt-2">
              🔒 256-bit Stripe Security &bull; Royal Mail Tracked 24
            </p>
          </div>
        </form>

        <!-- Garment Specs -->
        <div class="border-t-2 border-ink pt-4 space-y-3">
          <h3 class="text-xs font-display font-bold uppercase tracking-wider text-ink">
            Garment Blueprint
          </h3>
          
          <dl class="grid grid-cols-2 gap-3 text-xs font-medium">
            <div class="p-2.5 bg-canvas-butter/20 rounded-xl border border-ink">
              <dt class="font-bold text-ink">Fabric Weight</dt>
              <dd class="text-ink-light">{product.specs.weight}</dd>
            </div>
            <div class="p-2.5 bg-canvas-butter/20 rounded-xl border border-ink">
              <dt class="font-bold text-ink">Material</dt>
              <dd class="text-ink-light">{product.specs.material}</dd>
            </div>
            <div class="p-2.5 bg-canvas-butter/20 rounded-xl border border-ink">
              <dt class="font-bold text-ink">Fit Cut</dt>
              <dd class="text-ink-light">{product.specs.fit}</dd>
            </div>
            <div class="p-2.5 bg-canvas-butter/20 rounded-xl border border-ink">
              <dt class="font-bold text-ink">Origin</dt>
              <dd class="text-ink-light">{product.specs.origin}</dd>
            </div>
          </dl>
        </div>

      </div>
    </div>
  </article>

  <!-- Interactive script for radio swatch labels -->
  <script is:inline>
    document.querySelectorAll('input[name="color"]').forEach((radio) => {
      radio.addEventListener('change', (e) => {
        const label = document.getElementById('selected-color-label');
        if (label && e.target) {
          label.textContent = e.target.getAttribute('data-color-name');
        }
      });
    });
  </script>
</BaseLayout>
