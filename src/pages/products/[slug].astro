---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PRODUCTS, getProductBySlug } from '../../data/products';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { slug } = Astro.params;
const product = Astro.props.product || getProductBySlug(slug as string);

if (!product) {
  return Astro.redirect('/');
}
---

<BaseLayout
  title={`${product.title} - ${product.subtitle}`}
  description={product.description}
  image={product.images.primary}
>
  <!-- Breadcrumb Navigation -->
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-4" aria-label="Breadcrumb">
    <ol class="flex items-center space-x-2 text-xs font-mono text-atelier-400">
      <li>
        <a href="/" class="hover:text-white transition-colors">Home</a>
      </li>
      <li>/</li>
      <li>
        <a href="/#collection" class="hover:text-white transition-colors">Foundry Collection</a>
      </li>
      <li>/</li>
      <li class="text-white truncate" aria-current="page">{product.title}</li>
    </ol>
  </nav>

  <!-- Product Detail Section -->
  <article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <!-- Left: High Performance Editorial Imagery (Zero bloat, responsive picture elements) -->
      <div class="lg:col-span-7 space-y-6">
        <div class="aspect-[4/5] bg-atelier-900 border border-atelier-850 overflow-hidden relative shadow-2xl">
          {product.badge && (
            <span class="absolute top-4 left-4 z-20 px-3 py-1 bg-atelier-950/95 border border-atelier-750 text-xs font-mono uppercase tracking-widest text-white">
              {product.badge}
            </span>
          )}
          <picture>
            <source srcset={product.images.primary} media="(min-width: 640px)" />
            <img
              id="main-product-image"
              src={product.images.primary}
              alt={product.images.alt}
              width="1000"
              height="1250"
              loading="eager"
              decoding="async"
              class="w-full h-full object-cover object-center filter contrast-105"
            />
          </picture>
        </div>

        <!-- Secondary Detail Image -->
        <div class="grid grid-cols-2 gap-4">
          <div class="aspect-[4/3] bg-atelier-900 border border-atelier-850 overflow-hidden">
            <picture>
              <img
                src={product.images.secondary}
                alt={`${product.title} fabric texture and stitch view`}
                width="600"
                height="450"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover object-center grayscale contrast-110 hover:grayscale-0 transition-all duration-300"
              />
            </picture>
          </div>
          <div class="p-6 bg-atelier-900/60 border border-atelier-850 flex flex-col justify-center">
            <span class="text-[11px] font-mono uppercase tracking-widest text-doberman-tan block mb-1">
              Fabric Weave Profile
            </span>
            <span class="text-lg font-editorial font-bold text-white mb-2">{product.specs.weight}</span>
            <p class="text-xs text-atelier-400 leading-relaxed">
              Milled to hold crisp geometric volume across shoulders and torso during active handling.
            </p>
          </div>
        </div>
      </div>

      <!-- Right: Specification, Size Selector & Direct Stripe Checkout Form -->
      <div class="lg:col-span-5 flex flex-col space-y-8">
        <!-- Title & Header -->
        <header class="border-b border-atelier-850 pb-6">
          <span class="text-xs font-mono uppercase tracking-widest text-doberman-rust block mb-2">
            UK Streetwear &middot; Gentle Giant Series
          </span>
          <h1 class="text-3xl sm:text-4xl font-editorial font-bold text-white tracking-tight mb-3">
            {product.title}
          </h1>
          <p class="text-sm text-atelier-300 font-sans leading-relaxed mb-4">
            {product.subtitle}
          </p>

          <div class="flex items-baseline space-x-4">
            <span class="text-3xl font-editorial font-bold text-white">
              £{product.price}.00
            </span>
            <span class="text-xs font-mono text-atelier-400">
              GBP &middot; Tax Included &middot; Free UK Tracked 24 Delivery
            </span>
          </div>
        </header>

        <!-- Product Description & Editorial Notes -->
        <div class="space-y-4 text-xs leading-relaxed text-atelier-300">
          <p>{product.description}</p>
          <div class="p-4 bg-atelier-900/80 border-l-2 border-doberman-rust text-atelier-300 italic">
            &ldquo;{product.editorialNote}&rdquo;
          </div>
        </div>

        <!-- Checkout Form (Semantic HTML, Native POST to /api/checkout for 100/100 performance & zero bloat) -->
        <form
          id="checkout-form"
          action="/api/checkout"
          method="POST"
          class="space-y-6 pt-4 border-t border-atelier-850"
        >
          <input type="hidden" name="productId" value={product.id} />

          <!-- Color Swatch Selector -->
          <div>
            <div class="flex justify-between items-center text-xs font-mono uppercase tracking-wider mb-3">
              <span class="text-atelier-200">Garment Colorway:</span>
              <span id="selected-color-label" class="text-doberman-tan font-semibold">
                {product.colors[0].name}
              </span>
            </div>

            <fieldset class="flex space-x-3" aria-label="Choose a colorway">
              {product.colors.map((color, index) => (
                <label class="cursor-pointer relative flex items-center justify-center p-1 rounded-full hover:scale-105 transition-transform focus-within:ring-2 focus-within:ring-doberman-rust">
                  <input
                    type="radio"
                    name="color"
                    value={color.name}
                    checked={index === 0}
                    class="sr-only color-radio-input"
                    data-color-name={color.name}
                  />
                  <span
                    class="w-7 h-7 rounded-full border-2 border-atelier-700 peer-checked:border-white shadow-md block"
                    style={`background-color: ${color.hex};`}
                    title={color.name}
                  ></span>
                </label>
              ))}
            </fieldset>
          </div>

          <!-- Size Selector -->
          <div>
            <div class="flex justify-between items-center text-xs font-mono uppercase tracking-wider mb-3">
              <span class="text-atelier-200">Select Proportional Size:</span>
              <a href="#garment-specs" class="text-atelier-400 hover:text-white underline text-[11px]">
                View Size Specs
              </a>
            </div>

            <fieldset class="grid grid-cols-5 gap-2.5" aria-label="Select Garment Size">
              {product.sizes.map((size, idx) => (
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="size"
                    value={size}
                    checked={idx === 2} // Default to Large
                    class="sr-only size-radio-input"
                  />
                  <span class="size-box block text-center py-3 border border-atelier-750 text-xs font-mono uppercase font-semibold text-atelier-300 hover:border-white hover:text-white transition-all bg-atelier-900/50">
                    {size}
                  </span>
                </label>
              ))}
            </fieldset>
          </div>

          <!-- Quantity Selector -->
          <div>
            <label for="quantity-select" class="block text-xs font-mono uppercase tracking-wider text-atelier-200 mb-2">
              Quantity:
            </label>
            <select
              id="quantity-select"
              name="quantity"
              class="w-32 bg-atelier-900 border border-atelier-750 text-white font-mono text-xs py-2.5 px-3 focus:outline-none focus:ring-1 focus:ring-doberman-rust"
            >
              <option value="1">1 Garment</option>
              <option value="2">2 Garments</option>
              <option value="3">3 Garments</option>
              <option value="4">4 Garments</option>
            </select>
          </div>

          <!-- Buy Now CTA with Native Form Submit -->
          <div class="space-y-3 pt-2">
            <button
              type="submit"
              id="buy-button"
              class="w-full py-4 px-6 bg-white hover:bg-doberman-bone text-atelier-950 font-mono text-xs uppercase tracking-widest font-bold transition-all shadow-xl hover:shadow-doberman-rust/20 flex items-center justify-center space-x-2 focus:ring-2 focus:ring-doberman-rust focus:outline-none"
            >
              <span>Instant Stripe Checkout</span>
              <span aria-hidden="true">&rarr;</span>
            </button>

            <p class="text-[11px] text-center font-mono text-atelier-400">
              Safe 256-Bit SSL Encrypted &middot; Dispatched via Royal Mail Tracked 24
            </p>
          </div>
        </form>

        <!-- Garment Specs & Architecture Accordion -->
        <section id="garment-specs" class="border-t border-atelier-850 pt-6 space-y-4">
          <h2 class="text-xs font-mono uppercase tracking-widest text-white font-semibold">
            Garment Specifications & Craft
          </h2>

          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs font-mono">
            <div class="p-3 bg-atelier-900/40 border border-atelier-850">
              <dt class="text-atelier-400 uppercase text-[10px]">Garment Weight</dt>
              <dd class="text-white font-semibold mt-1">{product.specs.weight}</dd>
            </div>
            <div class="p-3 bg-atelier-900/40 border border-atelier-850">
              <dt class="text-atelier-400 uppercase text-[10px]">Composition</dt>
              <dd class="text-white font-semibold mt-1">{product.specs.material}</dd>
            </div>
            <div class="p-3 bg-atelier-900/40 border border-atelier-850">
              <dt class="text-atelier-400 uppercase text-[10px]">Cut Profile</dt>
              <dd class="text-white font-semibold mt-1">{product.specs.fit}</dd>
            </div>
            <div class="p-3 bg-atelier-900/40 border border-atelier-850">
              <dt class="text-atelier-400 uppercase text-[10px]">Origin</dt>
              <dd class="text-white font-semibold mt-1">{product.specs.origin}</dd>
            </div>
          </dl>

          <!-- Care Instructions -->
          <div class="p-3 bg-atelier-900/40 border border-atelier-850 text-xs font-mono">
            <span class="text-atelier-400 uppercase text-[10px] block">Garment Longevity:</span>
            <span class="text-atelier-200 mt-1 block">{product.specs.care}</span>
          </div>

          <!-- Feature Bullets -->
          <div class="pt-2">
            <span class="text-xs font-mono uppercase tracking-widest text-atelier-400 block mb-3">
              Architectural Highlights:
            </span>
            <ul class="space-y-2 text-xs text-atelier-300">
              {product.features.map(feat => (
                <li class="flex items-start space-x-2">
                  <span class="text-doberman-tan mt-0.5" aria-hidden="true">&bull;</span>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>

      </div>
    </div>
  </article>

  <!-- Lightweight, zero-dependency inline script for color/size visual feedback -->
  <script is:inline>
    // Update color label dynamically
    const colorRadios = document.querySelectorAll('.color-radio-input');
    const colorLabel = document.getElementById('selected-color-label');
    
    colorRadios.forEach((radio) => {
      radio.addEventListener('change', (e) => {
        if (colorLabel && e.target.checked) {
          colorLabel.textContent = e.target.getAttribute('data-color-name');
        }
      });
    });

    // Provide visual selected style for size radio boxes
    const sizeRadios = document.querySelectorAll('.size-radio-input');
    function updateSizeStyles() {
      sizeRadios.forEach((r) => {
        const box = r.nextElementSibling;
        if (r.checked) {
          box.classList.add('bg-white', 'text-atelier-950', 'border-white');
          box.classList.remove('bg-atelier-900/50', 'text-atelier-300', 'border-atelier-750');
        } else {
          box.classList.remove('bg-white', 'text-atelier-950', 'border-white');
          box.classList.add('bg-atelier-900/50', 'text-atelier-300', 'border-atelier-750');
        }
      });
    }
    sizeRadios.forEach(r => r.addEventListener('change', updateSizeStyles));
    updateSizeStyles();
  </script>
</BaseLayout>
