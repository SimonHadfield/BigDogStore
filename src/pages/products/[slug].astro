---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PRODUCTS, getProductBySlug } from '../../data/products';
import { BRAND_CONFIG } from '../../data/brand';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { slug } = Astro.params;
const product = Astro.props.product || getProductBySlug(slug as string);

if (!product) {
  return Astro.redirect('/');
}
---

<BaseLayout
  title={`${product.title} - ${BRAND_CONFIG.name}`}
  description={product.description}
  image={product.images.primary}
>
  <!-- Breadcrumb Navigation -->
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-4" aria-label="Breadcrumb">
    <ol class="flex items-center space-x-2 text-xs font-semibold text-espresso-600">
      <li>
        <a href="/" class="hover:text-tan transition-colors">Home</a>
      </li>
      <li>/</li>
      <li>
        <a href="/#collection" class="hover:text-tan transition-colors">Current Drop</a>
      </li>
      <li>/</li>
      <li class="text-espresso truncate" aria-current="page">{product.title}</li>
    </ol>
  </nav>

  <!-- Product Detail Section -->
  <article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <!-- Left: Imagery Showcase -->
      <div class="lg:col-span-7 space-y-6">
        <div class="aspect-[4/5] bg-sand-100 border border-sand-200 rounded-3xl overflow-hidden relative shadow-lg">
          {product.badge && (
            <span class="absolute top-4 left-4 z-20 px-3.5 py-1 bg-tan text-white text-xs font-bold uppercase tracking-wider rounded-full shadow-sm">
              {product.badge}
            </span>
          )}
          <picture>
            <source
              srcset={product.images.primary}
              media="(min-width: 640px)"
            />
            <img
              src={product.images.primary}
              alt={product.images.alt}
              width="1000"
              height="1250"
              loading="eager"
              decoding="async"
              class="w-full h-full object-cover"
            />
          </picture>
        </div>

        <!-- Secondary Detail View -->
        <div class="grid grid-cols-2 gap-4">
          <div class="aspect-square bg-sand-100 border border-sand-200 rounded-2xl overflow-hidden">
            <img
              src={product.images.secondary}
              alt={`${product.title} fabric and craftsmanship detail`}
              width="500"
              height="500"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="bg-sand-100 border border-sand-200 rounded-2xl p-6 flex flex-col justify-center">
            <span class="text-xs font-bold uppercase tracking-wider text-tan mb-1">
              Field Tested
            </span>
            <h4 class="text-sm font-display font-bold text-espresso mb-1">
              Dog Hair Resistant Weave
            </h4>
            <p class="text-xs text-espresso-600 leading-relaxed">
              Tightly combed organic loopback cotton prevents fur from embedding into the fibers. A simple swipe with a lint brush leaves it looking fresh.
            </p>
          </div>
        </div>
      </div>

      <!-- Right: Product Selector & Checkout Form -->
      <div class="lg:col-span-5 space-y-8">
        
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-sage">
              {product.specs.weight} &bull; Small-Batch Drop
            </span>
            <span class="text-xs font-mono text-espresso-500">
              {product.sku}
            </span>
          </div>

          <h1 class="text-2xl sm:text-4xl font-display font-bold text-espresso tracking-tight mb-2">
            {product.title}
          </h1>

          <p class="text-sm text-espresso-600 mb-4 leading-relaxed">
            {product.subtitle}
          </p>

          <div class="flex items-baseline space-x-3 pb-6 border-b border-sand-200">
            <span class="text-3xl font-display font-bold text-espresso">
              £{product.price}.00
            </span>
            <span class="text-xs text-espresso-500 font-semibold">
              GBP &bull; Free UK Delivery on orders over £70
            </span>
          </div>
        </div>

        <!-- Relatable Goofy Quote Box -->
        {product.goofyQuote && (
          <div class="p-4 bg-sand-100 rounded-2xl border border-sand-200 text-xs italic text-espresso-700 flex items-start gap-2.5">
            <span class="text-base not-italic">🐾</span>
            <div>
              <span class="font-bold not-italic block mb-0.5 text-espresso">The Big Dog Reality:</span>
              {product.goofyQuote}
            </div>
          </div>
        )}

        <!-- Manual Batch Fulfillment & Inspection Notice -->
        <div class="p-4 bg-butter/60 border border-amber-200/80 rounded-2xl text-xs text-espresso-800 space-y-1">
          <div class="flex items-center gap-1.5 font-bold text-amber-900">
            <span>⏳</span>
            <span>Small-Batch Hand Inspection</span>
          </div>
          <p class="text-espresso-700 leading-relaxed">
            Hoodies and apparel are ordered and hand-checked in small batches before dispatch (5–7 working days) so every print and seam is spot-on.
          </p>
        </div>

        <!-- Interactive Form -->
        <form
          action="/api/checkout"
          method="POST"
          id="checkout-form"
          class="space-y-6"
        >
          <!-- Hidden inputs required for Stripe session generation -->
          <input type="hidden" name="productId" value={product.id} />
          <input type="hidden" name="sku" value={product.sku} />

          <!-- Colorway Selector -->
          <fieldset class="space-y-3">
            <legend class="text-xs font-bold uppercase tracking-wider text-espresso">
              Select Colorway: <span id="selected-color-label" class="font-bold text-tan">{product.colors[0].name}</span>
            </legend>
            <div class="flex items-center space-x-3" role="radiogroup" aria-label="Available Colorways">
              {product.colors.map((color, idx) => (
                <label class="relative cursor-pointer group">
                  <input
                    type="radio"
                    name="color"
                    value={color.name}
                    checked={idx === 0}
                    class="sr-only peer"
                    data-color-name={color.name}
                  />
                  <span
                    class="block w-9 h-9 rounded-full border-2 border-sand-300 peer-checked:border-tan peer-checked:ring-2 peer-checked:ring-tan/30 transition-all shadow-sm"
                    style={`background-color: ${color.hex}`}
                    title={color.name}
                  ></span>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Size Selector -->
          <fieldset class="space-y-3">
            <div class="flex justify-between items-center">
              <legend class="text-xs font-bold uppercase tracking-wider text-espresso">
                Select Size (UK Standard S–XXL)
              </legend>
              <a href="#fit-matrix" class="text-xs font-semibold text-tan underline hover:text-tan-dark">
                Fit Guide
              </a>
            </div>
            
            <div class="grid grid-cols-5 gap-2.5">
              {product.sizes.map((size, idx) => (
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="size"
                    value={size}
                    checked={idx === 1}
                    class="sr-only peer"
                  />
                  <div class="py-3 text-center border-2 border-sand-200 bg-sand-100 rounded-xl text-xs font-bold text-espresso peer-checked:border-tan peer-checked:bg-tan peer-checked:text-white transition-all shadow-sm">
                    {size}
                  </div>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Buy Now / Add to Cart CTA -->
          <div class="pt-2">
            <button
              type="submit"
              id="submit-button"
              class="w-full py-4 px-6 bg-tan hover:bg-tan-dark active:scale-[0.98] text-white font-bold text-sm uppercase tracking-wider rounded-full transition-all shadow-md hover:shadow-lg flex items-center justify-center space-x-2"
            >
              <span>Secure UK Checkout &bull; £{product.price}.00</span>
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </button>
            <p class="text-center text-[11px] text-espresso-500 mt-2">
              🔒 Powered by Stripe &bull; Direct UK fulfillment via Royal Mail
            </p>
          </div>
        </form>

        <!-- Garment Specifications Breakdown -->
        <div class="border-t border-sand-200 pt-6 space-y-4">
          <h3 class="text-xs font-bold uppercase tracking-wider text-espresso">
            Garment Specifications
          </h3>
          
          <dl class="grid grid-cols-2 gap-x-4 gap-y-3 text-xs">
            <div>
              <dt class="font-bold text-espresso">Fabric Weight</dt>
              <dd class="text-espresso-600">{product.specs.weight}</dd>
            </div>
            <div>
              <dt class="font-bold text-espresso">Material</dt>
              <dd class="text-espresso-600">{product.specs.material}</dd>
            </div>
            <div>
              <dt class="font-bold text-espresso">Fit Silhouette</dt>
              <dd class="text-espresso-600">{product.specs.fit}</dd>
            </div>
            <div>
              <dt class="font-bold text-espresso">Origin</dt>
              <dd class="text-espresso-600">{product.specs.origin}</dd>
            </div>
          </dl>

          <div class="pt-2">
            <p class="text-xs text-espresso-600 leading-relaxed">
              <strong class="text-espresso">Care:</strong> {product.specs.care}
            </p>
          </div>
        </div>

        <!-- Key Features List -->
        <div class="border-t border-sand-200 pt-6 space-y-3">
          <h3 class="text-xs font-bold uppercase tracking-wider text-espresso">
            Why Dog Owners Love It
          </h3>
          <ul class="space-y-2 text-xs text-espresso-700">
            {product.features.map((feature) => (
              <li class="flex items-start space-x-2">
                <span class="text-tan mt-0.5">&bull;</span>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>

    <!-- Sizing Matrix Quick Ref Anchor -->
    <div id="fit-matrix" class="mt-20 pt-12 border-t border-sand-200">
      <h3 class="text-2xl font-display font-bold text-espresso text-center mb-6">
        Sizing Matrix & Lapdog Ratings
      </h3>
      <div class="max-w-4xl mx-auto overflow-x-auto bg-sand-100 border border-sand-200 rounded-2xl p-4 shadow-sm">
        <table class="w-full text-left text-xs sm:text-sm text-espresso">
          <caption class="sr-only">Detailed Fit Guide</caption>
          <thead>
            <tr class="border-b border-sand-200 font-bold uppercase text-[11px] text-espresso-600">
              <th scope="col" class="py-3 px-4">Size</th>
              <th scope="col" class="py-3 px-4">To Fit Chest</th>
              <th scope="col" class="py-3 px-4">Length</th>
              <th scope="col" class="py-3 px-4">Dog Breeds & Real Lapdog Fit</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-sand-200">
            <tr>
              <th scope="row" class="py-3 px-4 font-bold text-tan">Small</th>
              <td class="py-3 px-4">38 – 40"</td>
              <td class="py-3 px-4">70 cm</td>
              <td class="py-3 px-4 text-espresso-600">Whippet / Cocker Spaniel cuddles</td>
            </tr>
            <tr>
              <th scope="row" class="py-3 px-4 font-bold text-tan">Medium</th>
              <td class="py-3 px-4">40 – 42"</td>
              <td class="py-3 px-4">72 cm</td>
              <td class="py-3 px-4 text-espresso-600">Greyhound / Boxer head-rest</td>
            </tr>
            <tr>
              <th scope="row" class="py-3 px-4 font-bold text-tan">Large</th>
              <td class="py-3 px-4">42 – 44"</td>
              <td class="py-3 px-4">74 cm</td>
              <td class="py-3 px-4 text-espresso-600">40kg Doberman / German Shepherd full-lap occupation</td>
            </tr>
            <tr>
              <th scope="row" class="py-3 px-4 font-bold text-tan">X-Large</th>
              <td class="py-3 px-4">46 – 48"</td>
              <td class="py-3 px-4">76 cm</td>
              <td class="py-3 px-4 text-espresso-600">50kg Cane Corso / Rottweiler snuggles</td>
            </tr>
            <tr>
              <th scope="row" class="py-3 px-4 font-bold text-tan">2X-Large</th>
              <td class="py-3 px-4">50 – 52"</td>
              <td class="py-3 px-4">78 cm</td>
              <td class="py-3 px-4 text-espresso-600">70kg Great Dane / Irish Wolfhound blanket mode</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </article>

  <!-- Lightweight client script for live color swatch label update -->
  <script is:inline>
    document.querySelectorAll('input[name="color"]').forEach((radio) => {
      radio.addEventListener('change', (e) => {
        const label = document.getElementById('selected-color-label');
        if (label && e.target) {
          label.textContent = e.target.getAttribute('data-color-name');
        }
      });
    });
  </script>
</BaseLayout>
