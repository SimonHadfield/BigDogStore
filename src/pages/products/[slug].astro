---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PRODUCTS, getProductBySlug } from '../../data/products';
import { BRAND_CONFIG } from '../../data/brand';
import HoodieMockup from '../../components/HoodieMockup.astro';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { slug } = Astro.params;
const product = Astro.props.product || getProductBySlug(slug as string);

if (!product) {
  return Astro.redirect('/shop');
}
---

<BaseLayout
  title={`${product.title} - ${BRAND_CONFIG.name}`}
  description={product.description}
  image={product.images.primary}
>
  <!-- Clean Breadcrumb Navigation -->
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-4" aria-label="Breadcrumb">
    <ol class="flex items-center space-x-2 text-xs font-medium text-neutral-500">
      <li>
        <a href="/" class="hover:text-charcoal transition-colors">Home</a>
      </li>
      <li>/</li>
      <li>
        <a href="/shop#collection" class="hover:text-charcoal transition-colors">Drop 01</a>
      </li>
      <li>/</li>
      <li class="px-2.5 py-0.5 bg-neutral-100 rounded-full text-neutral-800 truncate max-w-[200px]" aria-current="page">
        {product.title}
      </li>
    </ol>
  </nav>

  <!-- Product Detail Section -->
  <article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      
      <!-- Left: Mockup & Detail Showcase -->
      <div class="lg:col-span-7 space-y-6">
        <div class="bg-[#F4ECE1] rounded-3xl p-6 sm:p-10 relative overflow-hidden">
          {product.badge && (
            <span class="absolute top-6 left-6 z-20 px-3.5 py-1 bg-charcoal text-white text-xs font-semibold uppercase tracking-wider rounded-full shadow-sm">
              {product.badge}
            </span>
          )}

          <!-- Clean Product Mockup Slot -->
          <div class="w-full">
            <HoodieMockup
              color={product.colors[0].slug === 'espresso' || product.colors[0].slug === 'onyx' ? '#1A1816' : product.colors[0].slug === 'sand' || product.colors[0].slug === 'bone' ? '#FAF8F5' : product.colors[0].slug === 'sage' ? '#4B5842' : '#C87A4B'}
              label={product.specs.weight}
              badge="Drop 01 Essential"
              hoodieColorName={product.colors[0].name}
              class="h-[420px] sm:h-[500px] bg-transparent border-0 shadow-none"
            />
          </div>
        </div>

        <!-- Feature Highlights in clean cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-white border border-neutral-200 rounded-2xl p-5 shadow-sm">
            <span class="text-xs font-semibold uppercase tracking-wider text-rust mb-1 block">
              🐾 Clumsy Paw Tested
            </span>
            <h4 class="text-sm font-semibold text-charcoal mb-1">
              Reinforced Bar-Tack Seams
            </h4>
            <p class="text-xs text-neutral-500 leading-relaxed font-normal">
              Engineered with heavy-duty twin-needle stitching to survive 40kg dogs pawing at the front pocket for biscuits.
            </p>
          </div>

          <div class="bg-white border border-neutral-200 rounded-2xl p-5 shadow-sm">
            <span class="text-xs font-semibold uppercase tracking-wider text-olive mb-1 block">
              ✨ Fur & Slobber Shield
            </span>
            <h4 class="text-sm font-semibold text-charcoal mb-1">
              Loopback Organic Cotton
            </h4>
            <p class="text-xs text-neutral-500 leading-relaxed font-normal">
              Tightly combed cotton loopback fleece that lets fur brush right off without digging into the weave.
            </p>
          </div>
        </div>
      </div>

      <!-- Right: Product Selector & Checkout Form -->
      <div class="lg:col-span-5 bg-white border border-neutral-200 rounded-3xl p-6 sm:p-8 shadow-sm space-y-6">
        
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="px-3 py-0.5 bg-neutral-100 text-neutral-700 text-xs font-semibold rounded-full">
              {product.specs.weight}
            </span>
            <span class="text-xs font-mono text-neutral-400">
              {product.sku}
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl font-display font-bold text-charcoal tracking-tight mb-2">
            {product.title}
          </h1>

          <p class="text-xs sm:text-sm text-neutral-500 font-normal mb-4 leading-relaxed">
            {product.subtitle}
          </p>

          <div class="flex items-baseline space-x-3 pb-4 border-b border-neutral-200">
            <span class="text-3xl font-display font-bold text-charcoal">
              £{product.price}.00
            </span>
            <span class="text-xs text-neutral-500 font-medium">
              GBP &bull; Free UK Shipping over £60
            </span>
          </div>
        </div>

        <!-- Relatable Goofy Quote -->
        {product.goofyQuote && (
          <div class="p-4 bg-[#F4ECE1] rounded-2xl text-xs font-medium text-charcoal flex items-start gap-2.5">
            <span class="text-lg">🐕</span>
            <div>
              <span class="font-semibold block mb-0.5 text-rust uppercase text-[11px]">The Big Dog Reality:</span>
              "{product.goofyQuote}"
            </div>
          </div>
        )}

        <!-- Small-Batch UK Hand-Inspection Notice -->
        <div class="p-4 bg-neutral-50 border border-neutral-200 rounded-2xl text-xs text-charcoal space-y-1">
          <div class="flex items-center gap-1.5 font-semibold text-charcoal">
            <span>⏳</span>
            <span>UK Small-Batch Hand Inspection</span>
          </div>
          <p class="text-neutral-500 font-normal leading-relaxed">
            Every garment is printed in small batches and hand-checked in Leicester, UK before dispatch (5–7 working days) so prints and seams are 100% spot-on.
          </p>
        </div>

        <!-- Interactive Form -->
        <form
          action="/api/checkout"
          method="POST"
          id="checkout-form"
          class="space-y-6"
        >
          <!-- Hidden inputs required for Stripe session generation -->
          <input type="hidden" name="productId" value={product.id} />
          <input type="hidden" name="sku" value={product.sku} />

          <!-- Colorway Selector -->
          <fieldset class="space-y-2">
            <legend class="text-xs font-semibold uppercase tracking-wider text-charcoal">
              Colorway: <span id="selected-color-label" class="text-rust">{product.colors[0].name}</span>
            </legend>
            <div class="flex items-center space-x-3" role="radiogroup" aria-label="Available Colorways">
              {product.colors.map((color, idx) => (
                <label class="relative cursor-pointer group">
                  <input
                    type="radio"
                    name="color"
                    value={color.name}
                    checked={idx === 0}
                    class="sr-only peer"
                    data-color-name={color.name}
                  />
                  <span
                    class="block w-9 h-9 rounded-full border border-neutral-300 peer-checked:ring-2 peer-checked:ring-offset-2 peer-checked:ring-charcoal transition-all shadow-sm"
                    style={`background-color: ${color.hex}`}
                    title={color.name}
                  ></span>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Size Selector -->
          <fieldset class="space-y-2">
            <div class="flex justify-between items-center">
              <legend class="text-xs font-semibold uppercase tracking-wider text-charcoal">
                Size (UK Standard S–XXL)
              </legend>
              <a href="/shop#fit-guide" class="text-xs font-medium text-rust hover:underline">
                Lapdog Fit Matrix
              </a>
            </div>
            
            <div class="grid grid-cols-5 gap-2">
              {product.sizes.map((size, idx) => (
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="size"
                    value={size}
                    checked={idx === 1}
                    class="sr-only peer"
                  />
                  <div class="py-2.5 text-center border border-neutral-200 bg-white rounded-xl text-xs font-semibold text-charcoal hover:bg-neutral-50 peer-checked:border-charcoal peer-checked:bg-charcoal peer-checked:text-white transition-all shadow-sm">
                    {size}
                  </div>
                </label>
              ))}
            </div>
          </fieldset>

          <!-- Buy Now CTA -->
          <div class="pt-2">
            <button
              type="submit"
              id="submit-button"
              class="w-full py-4 px-6 bg-charcoal hover:bg-neutral-800 text-white font-semibold text-xs sm:text-sm uppercase tracking-wider rounded-full transition-colors shadow-sm flex items-center justify-center space-x-2"
            >
              <span>Instant UK Stripe Checkout &bull; £{product.price}.00</span>
              <span>&rarr;</span>
            </button>
            <p class="text-center text-[11px] font-medium text-neutral-400 mt-2">
              🔒 256-bit Stripe Security &bull; Royal Mail Tracked 24
            </p>
          </div>
        </form>

        <!-- Garment Specs -->
        <div class="border-t border-neutral-200 pt-4 space-y-3">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-charcoal">
            Garment Blueprint
          </h3>
          
          <dl class="grid grid-cols-2 gap-3 text-xs">
            <div class="p-3 bg-neutral-50 rounded-xl border border-neutral-200/80">
              <dt class="font-semibold text-charcoal">Fabric Weight</dt>
              <dd class="text-neutral-500 mt-0.5">{product.specs.weight}</dd>
            </div>
            <div class="p-3 bg-neutral-50 rounded-xl border border-neutral-200/80">
              <dt class="font-semibold text-charcoal">Material</dt>
              <dd class="text-neutral-500 mt-0.5">{product.specs.material}</dd>
            </div>
            <div class="p-3 bg-neutral-50 rounded-xl border border-neutral-200/80">
              <dt class="font-semibold text-charcoal">Fit Cut</dt>
              <dd class="text-neutral-500 mt-0.5">{product.specs.fit}</dd>
            </div>
            <div class="p-3 bg-neutral-50 rounded-xl border border-neutral-200/80">
              <dt class="font-semibold text-charcoal">Origin</dt>
              <dd class="text-neutral-500 mt-0.5">{product.specs.origin}</dd>
            </div>
          </dl>
        </div>

      </div>
    </div>
  </article>

  <!-- Interactive script for radio swatch labels -->
  <script is:inline>
    document.querySelectorAll('input[name="color"]').forEach((radio) => {
      radio.addEventListener('change', (e) => {
        const label = document.getElementById('selected-color-label');
        if (label && e.target) {
          label.textContent = e.target.getAttribute('data-color-name');
        }
      });
    });
  </script>
</BaseLayout>
