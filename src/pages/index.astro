---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PRODUCTS } from '../data/products';
import { BRAND_CONFIG } from '../data/brand';
import HoodieMockup from '../components/HoodieMockup.astro';

// If WAITLIST_MODE is false, render the full storefront
const isWaitlist = BRAND_CONFIG.WAITLIST_MODE;
const heroProduct = PRODUCTS[0];
---

{isWaitlist ? (
  <BaseLayout
    title={`${BRAND_CONFIG.name} | Retro Streetwear for Clumsy Giants`}
    description="Drop 01 Coming Soon. Heavyweight 480GSM hoodies and retro streetwear inspired by 40kg lapdogs, clumsy paws, and personal space violations. Join the waitlist for early pack access."
  >
    <!-- Waitlist Hero Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left: Bold Playful Copy + Email Signup Form -->
        <div class="lg:col-span-7 space-y-6">
          
          <!-- Fun Neo-brutalist Sticker Badge Row -->
          <div class="flex flex-wrap items-center gap-3">
            <span class="px-3 py-1 bg-mint text-ink text-xs font-display font-bold uppercase rounded-lg border-2 border-ink shadow-brutal-sm transform -rotate-2">
              🐾 Drop 01 Coming Soon
            </span>
            <span class="px-3 py-1 bg-card-vanilla text-ink text-xs font-display font-bold uppercase rounded-lg border-2 border-ink shadow-brutal-sm transform rotate-1">
              🇬🇧 UK Hand-Checked
            </span>
            <span class="px-3 py-1 bg-rust text-white text-xs font-display font-bold uppercase rounded-lg border-2 border-ink shadow-brutal-sm transform -rotate-1">
              480GSM Heavyweight
            </span>
          </div>

          <!-- Bold Groovy Headline -->
          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-display font-bold text-ink tracking-tight leading-[1.05]">
            Streetwear for humans owned by <br />
            <span class="inline-block px-3 py-1 bg-card-vanilla border-2 border-ink shadow-brutal rounded-2xl text-rust transform -rotate-1 mt-2">
              40kg clumsy giants.
            </span>
          </h1>

          <!-- Body Subtext -->
          <p class="text-base sm:text-lg text-ink font-medium leading-relaxed max-w-xl">
            {BRAND_CONFIG.heroSubheadline} We're preparing our first limited micro-batch of loopback hoodies and vintage boxy tees.
          </p>

          <!-- Email Signup Form Card (Neo-Brutalist) -->
          <div id="waitlist" class="bg-card-vanilla border-2 border-ink rounded-3xl p-6 sm:p-8 shadow-brutal-lg max-w-xl space-y-4">
            <div>
              <span class="text-xs font-display font-bold uppercase tracking-wider text-rust block mb-1">
                Join The Pack Early Access
              </span>
              <h3 class="text-2xl font-display font-bold text-ink">
                Get first dibs on Drop 01
              </h3>
              <p class="text-xs text-ink-light font-medium mt-1">
                Zero spam. Only launch notifications, secret pack discounts, and clumsy dog memes.
              </p>
            </div>

            <form id="waitlist-form" class="space-y-3">
              <div class="flex flex-col sm:flex-row gap-3">
                <input
                  type="email"
                  name="email"
                  id="waitlist-email"
                  required
                  placeholder="enter.your@email.co.uk"
                  class="flex-grow px-4 py-3.5 bg-canvas-butter/20 border-2 border-ink rounded-xl text-sm font-bold text-ink placeholder:text-ink-light/60 focus:outline-none focus:ring-2 focus:ring-rust"
                />
                <button
                  type="submit"
                  id="waitlist-submit"
                  class="px-6 py-3.5 bg-rust hover:bg-rust-dark text-card-vanilla font-display font-bold text-sm uppercase tracking-wider rounded-xl border-2 border-ink shadow-brutal hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-brutal-hover active:translate-x-[4px] active:translate-y-[4px] active:shadow-none transition-all flex items-center justify-center space-x-2"
                >
                  <span>Bark At Me!</span>
                  <span>🐾</span>
                </button>
              </div>

              <!-- Live Status Message Container -->
              <div id="waitlist-status" class="hidden text-xs font-bold p-3 rounded-xl border-2 border-ink transition-all"></div>
            </form>

            <div class="flex items-center space-x-3 text-[11px] font-bold text-ink-light pt-1">
              <span>🔒 100% spam-free guarantee</span>
              <span>&bull;</span>
              <span>🇬🇧 UK micro-batch release</span>
            </div>
          </div>

          <!-- Quick Preview Store Link -->
          <div class="pt-2">
            <a
              href="/shop"
              class="inline-flex items-center text-xs font-display font-bold uppercase tracking-wider text-ink underline decoration-2 decoration-rust underline-offset-4 hover:text-rust"
            >
              👀 Want to peek at the full collection now? Browse the store preview &rarr;
            </a>
          </div>

        </div>

        <!-- Right: Drop 01 Teaser Preview Card with Hoodie Mockup -->
        <div class="lg:col-span-5">
          <div class="bg-card-vanilla border-2 border-ink rounded-3xl p-6 sm:p-8 shadow-brutal-xl relative transform rotate-1 hover:rotate-0 transition-transform duration-300">
            
            <!-- Corner Sticker -->
            <div class="absolute -top-4 -right-3 z-20 px-3 py-1.5 bg-canvas-butter text-ink font-display text-xs font-bold uppercase tracking-wider rounded-xl border-2 border-ink shadow-brutal-sm transform rotate-6">
              Drop 01 Star
            </div>

            <!-- Vector Mockup Component Slot -->
            <HoodieMockup
              color="#1A1614"
              label="480GSM French Loopback Fleece"
              badge="Drop 01 Hero"
              hoodieColorName="Obsidian Bark"
              class="mb-6"
            />

            <!-- Teaser Details -->
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="text-xl font-display font-bold text-ink">
                  Personal Space Violator Hoodie
                </h3>
                <span class="text-xl font-display font-bold text-rust">
                  £95
                </span>
              </div>
              <p class="text-xs text-ink-light font-medium leading-relaxed">
                480GSM heavyweight loopback cotton built for 40kg lapdogs who rest their heavy chins directly on your chest the moment you sit down.
              </p>

              <!-- Playful Quote Sticker -->
              <div class="p-3 bg-canvas-butter/40 border-2 border-ink rounded-xl text-xs font-bold text-ink italic">
                🐾 "If I fits, I sits. And even if I don't fits, I still sits on your lap."
              </div>

              <!-- Button linking to product preview -->
              <a
                href="/products/nobile-heavyweight-hoodie"
                class="block w-full text-center py-3.5 px-4 bg-ink hover:bg-rust text-card-vanilla font-display font-bold text-xs uppercase tracking-wider rounded-xl border-2 border-ink shadow-brutal hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-brutal-hover transition-all mt-4"
              >
                Inspect Piece Specs &rarr;
              </a>
            </div>

          </div>
        </div>

      </div>
    </section>

    <!-- Playful Badges Bar -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        
        <div class="bg-card-vanilla border-2 border-ink rounded-2xl p-4 shadow-brutal text-center transform -rotate-1 hover:rotate-0 transition-transform">
          <span class="text-3xl mb-1 block">🛋️</span>
          <span class="text-xs font-display font-bold text-ink uppercase block">Certified Couch Potato</span>
          <span class="text-[11px] text-ink-light font-medium">Built for 40kg lap snuggles</span>
        </div>

        <div class="bg-card-vanilla border-2 border-ink rounded-2xl p-4 shadow-brutal text-center transform rotate-1 hover:rotate-0 transition-transform">
          <span class="text-3xl mb-1 block">🐾</span>
          <span class="text-xs font-display font-bold text-ink uppercase block">40kg Lapdog Approved</span>
          <span class="text-[11px] text-ink-light font-medium">Loopback terry sheds fur easily</span>
        </div>

        <div class="bg-card-vanilla border-2 border-ink rounded-2xl p-4 shadow-brutal text-center transform -rotate-1 hover:rotate-0 transition-transform">
          <span class="text-3xl mb-1 block">💧</span>
          <span class="text-xs font-display font-bold text-ink uppercase block">Slobber Tested</span>
          <span class="text-[11px] text-ink-light font-medium">Thick fabric won't show splatter</span>
        </div>

        <div class="bg-card-vanilla border-2 border-ink rounded-2xl p-4 shadow-brutal text-center transform rotate-2 hover:rotate-0 transition-transform">
          <span class="text-3xl mb-1 block">🔍</span>
          <span class="text-xs font-display font-bold text-ink uppercase block">UK Hand-Checked</span>
          <span class="text-[11px] text-ink-light font-medium">Micro-batch printed in Leicester</span>
        </div>

      </div>
    </section>

    <!-- Lightweight Client-Side Waitlist Form Script -->
    <script is:inline>
      const form = document.getElementById('waitlist-form');
      const emailInput = document.getElementById('waitlist-email');
      const submitBtn = document.getElementById('waitlist-submit');
      const statusDiv = document.getElementById('waitlist-status');

      if (form && emailInput && statusDiv && submitBtn) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const email = emailInput.value.trim();

          if (!email) return;

          submitBtn.disabled = true;
          submitBtn.textContent = 'Barking...';
          statusDiv.className = 'hidden';

          try {
            const res = await fetch('/api/waitlist', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email }),
            });

            const data = await res.json();

            if (res.ok) {
              statusDiv.textContent = data.message || "You're in the pack! We'll bark when Drop 01 goes live. 🐾";
              statusDiv.className = 'block text-xs font-bold p-3 rounded-xl border-2 border-ink bg-mint text-ink shadow-brutal-sm';
              emailInput.value = '';
            } else {
              statusDiv.textContent = data.error || 'Oops! Please try again.';
              statusDiv.className = 'block text-xs font-bold p-3 rounded-xl border-2 border-ink bg-bubblegum text-ink shadow-brutal-sm';
            }
          } catch (err) {
            statusDiv.textContent = 'Network hiccup! Please try again.';
            statusDiv.className = 'block text-xs font-bold p-3 rounded-xl border-2 border-ink bg-bubblegum text-ink shadow-brutal-sm';
          } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Bark At Me!</span> <span>🐾</span>';
          }
        });
      }
    </script>
  </BaseLayout>
) : (
  <meta http-equiv="refresh" content="0; url=/shop" />
)}
