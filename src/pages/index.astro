---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PRODUCTS } from '../data/products';
import { BRAND_CONFIG } from '../data/brand';

const featuredProducts = PRODUCTS;
const heroProduct = PRODUCTS[0];
---

<BaseLayout
  title={`${BRAND_CONFIG.name} | Streetwear for Owners of 40kg Lapdogs`}
  description="Warm, casual, slightly goofy streetwear crafted for big dog lovers. Featuring 480GSM loopback cotton, small-batch hand checks, and designs made for clumsy affectionate giants."
>
  <!-- Hero Section: Bright Two-Column Layout on Warm Cream -->
  <section class="relative bg-cream-100 border-b border-sand-200 overflow-hidden">
    <!-- Subtle playful decorative circles in the background -->
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-sand-100 rounded-full blur-3xl opacity-70 pointer-events-none"></div>
    <div class="absolute top-1/2 -right-20 w-80 h-80 bg-tan-faint rounded-full blur-2xl opacity-60 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Left Column: Bold Playful Headline + Shop the Drop Button -->
        <div class="lg:col-span-7 space-y-8 text-left">
          
          <!-- Playful Badge -->
          <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 bg-sand-100 border border-sand-200 rounded-full shadow-sm">
            <span class="w-2 h-2 rounded-full bg-tan"></span>
            <span class="text-xs font-bold uppercase tracking-wider text-espresso">
              Dedicated to Clumsy Gentle Giants
            </span>
            <span class="text-xs bg-tan text-white font-bold px-2 py-0.5 rounded-full">Drop 01</span>
          </div>

          <!-- Headline -->
          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-display font-bold text-espresso tracking-tight leading-[1.08]">
            {BRAND_CONFIG.heroHeadline} <br />
            <span class="text-tan underline decoration-tan-light/50 decoration-wavy decoration-2">
              {BRAND_CONFIG.heroHighlight}
            </span>
          </h1>

          <!-- Body Copy -->
          <p class="text-lg sm:text-xl text-espresso-600 max-w-xl leading-relaxed">
            {BRAND_CONFIG.heroSubheadline}
          </p>

          <!-- Primary Actions -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
            <a
              href="#collection"
              class="inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white bg-tan hover:bg-tan-dark rounded-full transition-all shadow-md hover:shadow-lg active:scale-95 text-center"
            >
              Shop The Drop &darr;
            </a>
            <a
              href="#about"
              class="inline-flex items-center justify-center px-6 py-4 text-sm font-bold text-espresso-700 bg-sand-100 hover:bg-sand-200 border border-sand-200 rounded-full transition-colors text-center"
            >
              Read The Velcro Dog Story
            </a>
          </div>

          <!-- Micro reassurance -->
          <div class="flex flex-wrap items-center gap-6 pt-4 text-xs font-semibold text-espresso-600">
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-sage" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              No aggressive clichés
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-sage" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Claw & slobber resistant
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-sage" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Small-batch UK checks
            </span>
          </div>
        </div>

        <!-- Right Column: Clean Product Showcase Card (Light, warm, no dark moody overlays) -->
        <div class="lg:col-span-5">
          <div class="relative bg-sand-100 border-2 border-sand-200 rounded-3xl p-6 shadow-xl transform rotate-1 hover:rotate-0 transition-transform duration-300">
            
            <!-- Fun Badge Stamp -->
            <div class="absolute -top-4 -right-4 bg-tan text-white font-display text-xs font-bold px-3 py-1.5 rounded-full shadow-md tracking-wider uppercase transform rotate-6">
              Drop 01 Hero
            </div>

            <!-- Product Image -->
            <div class="aspect-[4/5] rounded-2xl overflow-hidden bg-sand-200 relative mb-5">
              <picture>
                <source
                  srcset={heroProduct.images.primary}
                  media="(min-width: 640px)"
                />
                <img
                  src={heroProduct.images.primary}
                  alt={heroProduct.title}
                  width="800"
                  height="1000"
                  loading="eager"
                  decoding="async"
                  class="w-full h-full object-cover rounded-2xl hover:scale-105 transition-transform duration-500"
                />
              </picture>
              <div class="absolute bottom-3 left-3 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-bold text-espresso shadow-sm">
                🐾 Heavyweight 480GSM Loopback
              </div>
            </div>

            <!-- Showcase Details -->
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="text-xl font-display font-bold text-espresso">
                  {heroProduct.title}
                </h3>
                <span class="text-xl font-bold text-tan">
                  £{heroProduct.price}
                </span>
              </div>
              <p class="text-xs text-espresso-600 line-clamp-2">
                {heroProduct.description}
              </p>
              
              <!-- Quote chip -->
              <div class="p-2.5 bg-cream-100 rounded-xl border border-sand-200 text-xs italic text-espresso-700">
                {heroProduct.goofyQuote}
              </div>

              <a
                href={`/products/${heroProduct.slug}`}
                class="block w-full text-center py-3 px-4 bg-espresso text-cream-100 font-bold rounded-xl hover:bg-tan transition-colors text-sm shadow-sm"
              >
                Snag This Hoodie &rarr;
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Trust Bar: Honest, Relatable Badges -->
  <section class="bg-sand-100 border-b border-sand-200 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        
        <div class="flex flex-col items-center space-y-1">
          <span class="text-2xl">🐕</span>
          <span class="text-xs font-bold text-espresso uppercase tracking-wider">Heavyweight & Fur-Friendly</span>
          <span class="text-[11px] text-espresso-600">Tight loopback yarn that easily brushes clean</span>
        </div>

        <div class="flex flex-col items-center space-y-1">
          <span class="text-2xl">🔍</span>
          <span class="text-xs font-bold text-espresso uppercase tracking-wider">Hand-Checked in the UK</span>
          <span class="text-[11px] text-espresso-600">Every print inspected before dispatch (5–7 days)</span>
        </div>

        <div class="flex flex-col items-center space-y-1">
          <span class="text-2xl">📦</span>
          <span class="text-xs font-bold text-espresso uppercase tracking-wider">Small-Batch Drops</span>
          <span class="text-[11px] text-espresso-600">Zero mass waste, strictly limited runs</span>
        </div>

        <div class="flex flex-col items-center space-y-1">
          <span class="text-2xl">🛋️</span>
          <span class="text-xs font-bold text-espresso uppercase tracking-wider">Couch Tested</span>
          <span class="text-[11px] text-espresso-600">Durable against 40kg paws and sofa zoomies</span>
        </div>

      </div>
    </div>
  </section>

  <!-- Featured Collection Grid Section -->
  <section id="collection" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 border-b border-sand-200 pb-6">
      <div>
        <div class="inline-flex items-center space-x-2 text-xs font-bold uppercase tracking-wider text-tan mb-2">
          <span>🐾 Current Edition</span>
        </div>
        <h2 class="text-3xl sm:text-5xl font-display font-bold text-espresso tracking-tight">
          The Big Dog Streetwear Drop
        </h2>
      </div>
      <p class="text-sm text-espresso-600 max-w-md mt-4 md:mt-0 leading-relaxed">
        Ultra-heavyweight hoodies, boxy vintage tees, and rugged canvas shirts. Made to survive 40kg cuddle sessions and UK park rain.
      </p>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {featuredProducts.map((product) => (
        <article class="group bg-sand-100 border border-sand-200 rounded-2xl overflow-hidden flex flex-col justify-between hover:border-tan transition-all shadow-sm hover:shadow-md">
          <div>
            <!-- Product Card Image -->
            <div class="aspect-[4/5] bg-sand-200 relative overflow-hidden">
              {product.badge && (
                <span class="absolute top-3 left-3 z-10 px-2.5 py-1 bg-tan text-white text-[11px] font-bold rounded-full shadow-sm tracking-wide">
                  {product.badge}
                </span>
              )}
              <picture>
                <img
                  src={product.images.primary}
                  alt={product.images.alt}
                  width="600"
                  height="750"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </picture>
            </div>

            <!-- Content -->
            <div class="p-5 space-y-3">
              <div class="flex items-center justify-between text-xs text-espresso-600">
                <span class="font-bold text-sage">{product.specs.weight}</span>
                <span class="font-mono">{product.sku}</span>
              </div>

              <h3 class="text-lg font-display font-bold text-espresso group-hover:text-tan transition-colors">
                <a href={`/products/${product.slug}`} class="focus:outline-none">
                  {product.title}
                </a>
              </h3>

              <p class="text-xs text-espresso-600 line-clamp-2 leading-relaxed">
                {product.subtitle}
              </p>

              <!-- Relatable Goofy Quote -->
              {product.goofyQuote && (
                <p class="text-[11px] italic text-tan-dark bg-cream-100 p-2 rounded-lg border border-sand-200">
                  {product.goofyQuote}
                </p>
              )}
            </div>
          </div>

          <!-- Bottom Price & CTA -->
          <div class="p-5 pt-0">
            <div class="flex items-center justify-between pt-3 border-t border-sand-200">
              <span class="text-lg font-display font-bold text-espresso">
                £{product.price}.00
              </span>
              <a
                href={`/products/${product.slug}`}
                class="px-4 py-2 bg-espresso text-cream-100 hover:bg-tan text-xs font-bold uppercase tracking-wider rounded-full transition-colors"
                aria-label={`View ${product.title}`}
              >
                View Piece &rarr;
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Small-Batch Fulfillment & Quality Check Section -->
  <section id="batch-info" class="bg-sand-100 border-y border-sand-200 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-cream-100 border border-sand-200 rounded-3xl p-8 sm:p-12 shadow-sm text-center">
        
        <div class="inline-flex items-center space-x-2 px-3 py-1 bg-sage-faint text-sage-dark font-bold text-xs uppercase tracking-wider rounded-full mb-4">
          <span>🇬🇧 Small-Batch UK Craftsmanship</span>
        </div>

        <h2 class="text-3xl sm:text-4xl font-display font-bold text-espresso mb-4">
          Why Small-Batch Hand-Checked Drops?
        </h2>

        <p class="text-espresso-700 max-w-2xl mx-auto text-base sm:text-lg leading-relaxed mb-8">
          Mass-produced fast fashion falls apart after one enthusiastic paw swipe. We produce every piece in limited micro-batches in Leicester, UK. Every garment is individually inspected for seam integrity, print sharpness, and fabric heft before being packaged in plastic-free mailers.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-left">
          <div class="bg-white p-5 rounded-2xl border border-sand-200">
            <div class="text-2xl mb-2">🧵</div>
            <h3 class="font-display font-bold text-espresso mb-1">Reinforced Bar-Tack Seams</h3>
            <p class="text-xs text-espresso-600">Built to withstand leash tension, excited jumps, and endless wash cycles.</p>
          </div>

          <div class="bg-white p-5 rounded-2xl border border-sand-200">
            <div class="text-2xl mb-2">⏳</div>
            <h3 class="font-display font-bold text-espresso mb-1">5–7 Day Hand-Check</h3>
            <p class="text-xs text-espresso-600">Orders are individually checked and prepared with care so every print is 100% spot-on.</p>
          </div>

          <div class="bg-white p-5 rounded-2xl border border-sand-200">
            <div class="text-2xl mb-2">🌿</div>
            <h3 class="font-display font-bold text-espresso mb-1">GOTS Certified Organic</h3>
            <p class="text-xs text-espresso-600">Clean, pesticide-free cotton that feels heavenly against both human skin and dog snouts.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Size & Fit Guide Section: S–XXL Detailed Matrix -->
  <section id="fit-guide" class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="inline-flex items-center space-x-2 text-xs font-bold uppercase tracking-wider text-tan mb-2">
        <span>📏 Zero Guesswork</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-display font-bold text-espresso tracking-tight mb-4">
        The Human Fit Matrix (S–XXL)
      </h2>
      <p class="text-sm text-espresso-600">
        Our garments feature a relaxed, dropped-shoulder streetwear drape. Order your normal size for a comfy roomy fit, or size down if you prefer a standard tailored look.
      </p>
    </div>

    <!-- Responsive Table -->
    <div class="overflow-x-auto bg-sand-100 border border-sand-200 rounded-2xl p-4 shadow-sm">
      <table class="w-full text-left text-sm text-espresso">
        <caption class="sr-only">Garment Sizing Matrix for Big Dog Club</caption>
        <thead>
          <tr class="border-b border-sand-200 text-xs uppercase font-bold text-espresso-600">
            <th scope="col" class="py-4 px-4">Size</th>
            <th scope="col" class="py-4 px-4">Chest (Inches)</th>
            <th scope="col" class="py-4 px-4">Body Length (cm)</th>
            <th scope="col" class="py-4 px-4">Sleeve Length (cm)</th>
            <th scope="col" class="py-4 px-4">Lapdog Capacity</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-sand-200 font-sans text-xs sm:text-sm">
          <tr class="hover:bg-cream-100 transition-colors">
            <th scope="row" class="py-4 px-4 font-bold text-tan">Small (S)</th>
            <td class="py-4 px-4">38 – 40"</td>
            <td class="py-4 px-4">70 cm</td>
            <td class="py-4 px-4">64 cm</td>
            <td class="py-4 px-4 text-espresso-600">Fits 1 medium whippet or 1/2 of a Doberman lap-sit</td>
          </tr>
          <tr class="hover:bg-cream-100 transition-colors">
            <th scope="row" class="py-4 px-4 font-bold text-tan">Medium (M)</th>
            <td class="py-4 px-4">40 – 42"</td>
            <td class="py-4 px-4">72 cm</td>
            <td class="py-4 px-4">65 cm</td>
            <td class="py-4 px-4 text-espresso-600">Cushions a 35kg Greyhound or boxer head-rest</td>
          </tr>
          <tr class="hover:bg-cream-100 transition-colors">
            <th scope="row" class="py-4 px-4 font-bold text-tan">Large (L)</th>
            <td class="py-4 px-4">42 – 44"</td>
            <td class="py-4 px-4">74 cm</td>
            <td class="py-4 px-4">66 cm</td>
            <td class="py-4 px-4 text-espresso-600">Certified for 40kg Dobermans with zero boundaries</td>
          </tr>
          <tr class="hover:bg-cream-100 transition-colors">
            <th scope="row" class="py-4 px-4 font-bold text-tan">X-Large (XL)</th>
            <td class="py-4 px-4">46 – 48"</td>
            <td class="py-4 px-4">76 cm</td>
            <td class="py-4 px-4">67 cm</td>
            <td class="py-4 px-4 text-espresso-600">Easily absorbs a 50kg Cane Corso chin-drop</td>
          </tr>
          <tr class="hover:bg-cream-100 transition-colors">
            <th scope="row" class="py-4 px-4 font-bold text-tan">2X-Large (XXL)</th>
            <td class="py-4 px-4">50 – 52"</td>
            <td class="py-4 px-4">78 cm</td>
            <td class="py-4 px-4">68 cm</td>
            <td class="py-4 px-4 text-espresso-600">Accommodates a 70kg Great Dane trying to crawl into your lap</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Relatable Brand Manifesto Story Block -->
  <section id="about" class="bg-cream-200 border-t border-sand-200 py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-8">
      <div class="inline-flex items-center space-x-2 text-xs font-bold uppercase tracking-wider text-sage-dark">
        <span>📖 The Velcro Dog Manifesto</span>
      </div>

      <h2 class="text-3xl sm:text-5xl font-display font-bold text-espresso tracking-tight">
        "Big dogs don't have personal space. <br />They have your space."
      </h2>

      <div class="space-y-6 text-espresso-700 text-base sm:text-lg leading-relaxed text-left max-w-2xl mx-auto">
        <p>
          Society sees big breeds—Dobermans, Rottweilers, Great Danes, Mastiffs—and imagines guard dogs pacing barbed-wire fences. But anyone who actually lives with one knows the hilarious truth:
        </p>
        <p>
          They are 40kg sacks of pure affection who get spooked by the toaster, cry if their tennis ball rolls under the couch, and firmly believe their 90-pound body can fit comfortably on your chest while you try to watch TV.
        </p>
        <p>
          We created <strong>{BRAND_CONFIG.name}</strong> to replace the aggressive, scary clichés with clothes that celebrate the goofy, devoted, velcro-like reality of living with gentle giants. No spiked collars or edgy gothic skulls—just premium, heavy cotton built for the best clumsy companions on earth.
        </p>
      </div>

      <div class="pt-6">
        <a
          href="#collection"
          class="inline-flex items-center px-8 py-4 bg-tan hover:bg-tan-dark text-white font-bold rounded-full transition-all shadow-md hover:shadow-lg"
        >
          Join The Club &bull; Shop The Drop
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
