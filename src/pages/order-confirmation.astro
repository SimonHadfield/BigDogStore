---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { stripe } from '../lib/stripe';
import { BRAND_CONFIG } from '../data/brand';

const sessionId = Astro.url.searchParams.get('session_id');
let orderDetails: any = null;

if (sessionId) {
  try {
    orderDetails = await stripe.checkout.sessions.retrieve(sessionId, {
      expand: ['customer_details', 'shipping_details', 'line_items'],
    });
  } catch (err) {
    console.error('Error fetching session details:', err);
  }
}
---

<BaseLayout
  title={`Order Locked In! | ${BRAND_CONFIG.name}`}
  description="Your Clumsy Giants apparel order is registered and queued for UK small-batch hand inspection."
>
  <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
    
    <!-- Clean Success Badge -->
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-emerald-50 text-emerald-600 mb-6 border border-emerald-200 shadow-sm">
      <span class="text-3xl">🐾</span>
    </div>

    <span class="px-3.5 py-1 bg-neutral-100 rounded-full text-xs font-semibold uppercase tracking-wider text-charcoal inline-block mb-3">
      Order Confirmed &bull; Royal Mail Tracked 24
    </span>
    <h1 class="text-3xl sm:text-5xl font-display font-bold text-charcoal tracking-tight mb-4">
      Give That Giant a Belly Rub!
    </h1>

    <p class="text-base text-neutral-600 font-normal leading-relaxed max-w-xl mx-auto mb-8">
      Your order is locked into our production queue. Give that clumsy lapdog an ear scratch for us—your heavyweight streetwear is on its way.
    </p>

    <!-- Small-Batch UK Hand Check Notice Box -->
    <div class="p-6 bg-[#FAF9F6] border border-neutral-200 rounded-3xl text-left text-sm text-charcoal space-y-2 mb-8 shadow-sm">
      <div class="flex items-center gap-2 font-semibold text-charcoal">
        <span class="text-lg">🔍</span>
        <span>UK Micro-Batch Hand Inspection (5–7 Working Days)</span>
      </div>
      <p class="text-xs sm:text-sm text-neutral-600 font-normal leading-relaxed">
        Because big dogs play rough, your garments are printed in small batches and hand-checked right here in Leicester, UK before dispatch (5–7 working days). Once inspected and packaged in eco-friendly mailers, you'll receive your Royal Mail Tracked 24 tracking link directly by email.
      </p>
    </div>

    <!-- Order Metadata Card -->
    <div class="p-6 sm:p-8 bg-white border border-neutral-200 rounded-3xl text-left text-xs space-y-4 mb-8 shadow-sm">
      <div class="flex flex-col sm:flex-row justify-between border-b border-neutral-200 pb-4">
        <div>
          <span class="text-neutral-400 block uppercase text-[10px] font-semibold">Stripe Reference</span>
          <span class="text-charcoal font-mono font-bold">{sessionId ? sessionId.slice(0, 24) + '...' : 'REF-CG-' + Math.floor(100000 + Math.random() * 900000)}</span>
        </div>
        <div class="mt-2 sm:mt-0">
          <span class="text-neutral-400 block uppercase text-[10px] font-semibold">Status</span>
          <span class="text-emerald-700 font-semibold flex items-center">
            <span class="w-2 h-2 rounded-full bg-emerald-500 mr-1.5 animate-pulse"></span>
            Queued for Hand-Check
          </span>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 border-b border-neutral-200 pb-4 font-normal">
        <div>
          <span class="text-neutral-400 block uppercase text-[10px] font-semibold">Estimated Dispatch</span>
          <span class="text-charcoal font-semibold">5–7 Working Days (UK Hand-Check)</span>
        </div>
        <div>
          <span class="text-neutral-400 block uppercase text-[10px] font-semibold">Shipping Carrier</span>
          <span class="text-charcoal font-semibold">Royal Mail Tracked 24 (United Kingdom)</span>
        </div>
      </div>

      {orderDetails?.shipping_details?.address && (
        <div class="pt-2 font-normal">
          <span class="text-neutral-400 block uppercase text-[10px] font-semibold">Delivery Address</span>
          <p class="text-charcoal mt-1 font-medium">
            {orderDetails.shipping_details.name}<br />
            {orderDetails.shipping_details.address.line1}<br />
            {orderDetails.shipping_details.address.city}, {orderDetails.shipping_details.address.postal_code}<br />
            {orderDetails.shipping_details.address.country}
          </p>
        </div>
      )}
    </div>

    <!-- Help & Next Steps -->
    <div class="space-y-4">
      <p class="text-xs text-neutral-500">
        Need to adjust your size or address before printing starts? Woof at us at <a href={`mailto:${BRAND_CONFIG.contactEmail}`} class="text-charcoal underline font-semibold">{BRAND_CONFIG.contactEmail}</a>.
      </p>

      <a
        href="/"
        class="inline-block px-8 py-3.5 bg-charcoal hover:bg-neutral-800 text-white font-semibold text-xs uppercase tracking-wider rounded-full transition-colors shadow-sm"
      >
        Return to Home &rarr;
      </a>
    </div>

  </main>
</BaseLayout>
