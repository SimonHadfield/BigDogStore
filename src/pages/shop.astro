---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PRODUCTS } from '../data/products';
import { BRAND_CONFIG } from '../data/brand';
import HoodieMockup from '../components/HoodieMockup.astro';

const featuredProducts = PRODUCTS;
---

<BaseLayout
  title="The Clumsy Giants Store & Drop Catalog"
  description="Explore Drop 01 of Clumsy Giants: 480GSM loopback hoodies, chunky 280GSM tees, and durable streetwear built for 40kg lapdogs and clumsy gentle giants."
>
  <!-- Shop Header Banner (Clean Modern Outdoor Streetwear on Pure White) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-8">
    <div class="bg-[#FAF9F6] border border-neutral-200 rounded-3xl p-8 sm:p-12">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="space-y-3">
          <div class="flex flex-wrap items-center gap-2">
            <span class="px-3 py-1 bg-charcoal text-white text-xs font-semibold uppercase tracking-wider rounded-full">
              Drop 01 Catalog
            </span>
            <span class="px-3 py-1 bg-white border border-neutral-200 text-neutral-700 text-xs font-semibold uppercase tracking-wider rounded-full">
              🇬🇧 UK Hand-Checked
            </span>
          </div>
          <h1 class="text-4xl sm:text-5xl font-display font-bold text-charcoal tracking-tight">
            Elevated Streetwear for Clumsy Giants
          </h1>
          <p class="text-base sm:text-lg text-neutral-600 max-w-xl font-normal leading-relaxed">
            Heavyweight hoodies, boxy vintage tees, and rugged overshirts designed for 40kg lapdogs, accidental knee knocks, and the best clumsy companions on earth.
          </p>
        </div>

        <div class="flex flex-col items-start md:items-end gap-3 flex-shrink-0">
          <a
            href="/"
            class="px-5 py-2.5 bg-white hover:bg-neutral-50 text-charcoal font-semibold text-xs uppercase tracking-wider rounded-full border border-neutral-200 transition-colors"
          >
            &larr; Back to Waitlist
          </a>
          <span class="text-xs text-neutral-500 font-medium">Royal Mail Tracked 24 across the UK</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Collection Grid Section -->
  <section id="collection" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 pb-4 border-b border-neutral-200">
      <div>
        <span class="text-xs font-semibold uppercase tracking-widest text-rust">
          Limited Capsule Release
        </span>
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-charcoal tracking-tight mt-1">
          The Drop 01 Apparel
        </h2>
      </div>
      <p class="text-sm font-normal text-neutral-500 max-w-md mt-2 md:mt-0">
        Click any piece to choose your size, select colorways, and initiate secure Stripe UK checkout.
      </p>
    </div>

    <!-- Product Grid with Clean Mockup Slots in soft rounded #F4ECE1 cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {featuredProducts.map((product, idx) => (
        <article class="group bg-[#F4ECE1] rounded-3xl overflow-hidden flex flex-col justify-between transition-transform duration-300 hover:-translate-y-1 shadow-sm">
          <div>
            <!-- Clean Product Mockup Slot -->
            <div class="p-4 bg-white/40 relative">
              {product.badge && (
                <span class="absolute top-6 left-6 z-20 px-3 py-1 bg-charcoal text-white text-[10px] font-semibold uppercase tracking-wider rounded-full">
                  {product.badge}
                </span>
              )}
              <HoodieMockup
                color={idx === 0 ? '#1A1816' : idx === 1 ? '#FAF8F5' : idx === 2 ? '#4B5842' : '#C87A4B'}
                label={product.specs.weight}
                badge={idx === 0 ? 'Signature Piece' : 'Drop 01'}
                hoodieColorName={product.colors[0].name}
                class="bg-transparent border-0 shadow-none"
              />
            </div>

            <!-- Content Area -->
            <div class="p-5 space-y-3">
              <div class="flex items-center justify-between text-xs font-medium text-neutral-500">
                <span class="px-2.5 py-0.5 bg-white rounded-full text-neutral-700 font-mono text-[10px]">
                  {product.specs.weight}
                </span>
                <span class="font-mono text-[11px]">{product.sku}</span>
              </div>

              <h3 class="text-xl font-display font-bold text-charcoal group-hover:text-rust transition-colors leading-snug">
                <a href={`/products/${product.slug}`} class="focus:outline-none">
                  {product.title}
                </a>
              </h3>

              <p class="text-xs text-neutral-600 font-normal line-clamp-2 leading-relaxed">
                {product.subtitle}
              </p>

              <!-- Quote -->
              {product.goofyQuote && (
                <div class="p-3 bg-white/70 rounded-xl text-[11px] font-medium text-neutral-700">
                  🐾 "{product.goofyQuote}"
                </div>
              )}
            </div>
          </div>

          <!-- Bottom Price & CTA -->
          <div class="p-5 pt-0">
            <div class="flex items-center justify-between pt-3 border-t border-neutral-200/60">
              <span class="text-2xl font-display font-bold text-charcoal">
                £{product.price}.00
              </span>
              <a
                href={`/products/${product.slug}`}
                class="px-4 py-2.5 bg-charcoal hover:bg-neutral-800 text-white font-semibold text-xs uppercase tracking-wider rounded-full transition-colors"
                aria-label={`View ${product.title}`}
              >
                Inspect Piece &rarr;
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Small-Batch UK Craftsmanship Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="bg-[#FAF9F6] border border-neutral-200 rounded-3xl p-8 sm:p-12">
      <div class="max-w-3xl mx-auto text-center space-y-4">
        <span class="px-3.5 py-1 bg-white border border-neutral-200 text-neutral-700 text-xs font-semibold uppercase tracking-wider rounded-full inline-block">
          🇬🇧 Micro-Batch Printing & Hand Checks
        </span>
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-charcoal tracking-tight">
          Hand-Inspected in the UK Before Dispatch
        </h2>
        <p class="text-sm sm:text-base text-neutral-600 font-normal leading-relaxed">
          Big dogs play rough, which is why our apparel is built to last. We order and print in limited batches in Leicester, UK. Every single hoodie and tee is individually inspected for seam integrity and heavyweight heft before being boxed in eco-friendly packaging (5–7 working days dispatch).
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-6 text-left">
          <div class="bg-white rounded-2xl p-5 border border-neutral-200/80">
            <div class="w-8 h-8 rounded-full bg-neutral-100 flex items-center justify-center text-charcoal mb-2 text-sm font-semibold">🧵</div>
            <h3 class="font-semibold text-sm text-charcoal">Bar-Tack Reinforced</h3>
            <p class="text-xs text-neutral-500 mt-1">Pockets survive leashes, paw digs, and frantic treat rummaging.</p>
          </div>
          <div class="bg-white rounded-2xl p-5 border border-neutral-200/80">
            <div class="w-8 h-8 rounded-full bg-neutral-100 flex items-center justify-center text-charcoal mb-2 text-sm font-semibold">🌿</div>
            <h3 class="font-semibold text-sm text-charcoal">Organic Loopback Cotton</h3>
            <p class="text-xs text-neutral-500 mt-1">480GSM high-density terry that dog hair brushes clean from.</p>
          </div>
          <div class="bg-white rounded-2xl p-5 border border-neutral-200/80">
            <div class="w-8 h-8 rounded-full bg-neutral-100 flex items-center justify-center text-charcoal mb-2 text-sm font-semibold">📦</div>
            <h3 class="font-semibold text-sm text-charcoal">Tracked 24 Delivery</h3>
            <p class="text-xs text-neutral-500 mt-1">Delivered via Royal Mail straight to your UK doorstep.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Human & Lapdog Fit Matrix -->
  <section id="fit-guide" class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center max-w-2xl mx-auto mb-8">
      <span class="px-3 py-1 bg-charcoal text-white text-xs font-semibold uppercase tracking-wider rounded-full inline-block mb-2">
        📏 Real Lapdog Ratings
      </span>
      <h2 class="text-3xl sm:text-4xl font-display font-bold text-charcoal mb-2">
        Human Size Guide (S–XXL)
      </h2>
      <p class="text-sm text-neutral-500">
        Cut with a generous, relaxed streetwear drape. Select your normal size for cozy cuddle sessions, or size down for standard fitted wear.
      </p>
    </div>

    <!-- Responsive Clean Table -->
    <div class="overflow-x-auto bg-white border border-neutral-200 rounded-3xl p-6 sm:p-8 shadow-sm">
      <table class="w-full text-left text-sm text-charcoal">
        <caption class="sr-only">Garment Sizing Matrix for Clumsy Giants</caption>
        <thead>
          <tr class="border-b border-neutral-200 text-xs uppercase font-semibold text-neutral-400">
            <th scope="col" class="py-3 px-4">Size</th>
            <th scope="col" class="py-3 px-4">Chest</th>
            <th scope="col" class="py-3 px-4">Length</th>
            <th scope="col" class="py-3 px-4">Sleeve</th>
            <th scope="col" class="py-3 px-4">Clumsy Lapdog Capacity</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-100 text-xs sm:text-sm font-normal">
          <tr>
            <th scope="row" class="py-3.5 px-4 font-semibold text-charcoal">Small (S)</th>
            <td class="py-3.5 px-4">38 – 40"</td>
            <td class="py-3.5 px-4">70 cm</td>
            <td class="py-3.5 px-4">64 cm</td>
            <td class="py-3.5 px-4 text-neutral-500">Fits 1 whippet or 1/2 of a Doberman lap-sit</td>
          </tr>
          <tr>
            <th scope="row" class="py-3.5 px-4 font-semibold text-charcoal">Medium (M)</th>
            <td class="py-3.5 px-4">40 – 42"</td>
            <td class="py-3.5 px-4">72 cm</td>
            <td class="py-3.5 px-4">65 cm</td>
            <td class="py-3.5 px-4 text-neutral-500">Cushions a 35kg Greyhound or Boxer chin-rest</td>
          </tr>
          <tr>
            <th scope="row" class="py-3.5 px-4 font-semibold text-charcoal">Large (L)</th>
            <td class="py-3.5 px-4">42 – 44"</td>
            <td class="py-3.5 px-4">74 cm</td>
            <td class="py-3.5 px-4">66 cm</td>
            <td class="py-3.5 px-4 text-neutral-500">Certified for 40kg Dobermans with zero boundaries</td>
          </tr>
          <tr>
            <th scope="row" class="py-3.5 px-4 font-semibold text-charcoal">X-Large (XL)</th>
            <td class="py-3.5 px-4">46 – 48"</td>
            <td class="py-3.5 px-4">76 cm</td>
            <td class="py-3.5 px-4">67 cm</td>
            <td class="py-3.5 px-4 text-neutral-500">Absorbs a 50kg Cane Corso or Rottie full snuffle</td>
          </tr>
          <tr>
            <th scope="row" class="py-3.5 px-4 font-semibold text-charcoal">2X-Large (XXL)</th>
            <td class="py-3.5 px-4">50 – 52"</td>
            <td class="py-3.5 px-4">78 cm</td>
            <td class="py-3.5 px-4">68 cm</td>
            <td class="py-3.5 px-4 text-neutral-500">Accommodates a 70kg Great Dane blanket mode</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Brand Story Block -->
  <section id="about" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="bg-[#FAF9F6] border border-neutral-200 rounded-3xl p-8 sm:p-12 text-center space-y-6">
      <span class="px-3.5 py-1 bg-white border border-neutral-200 text-neutral-700 text-xs font-semibold uppercase tracking-wider rounded-full inline-block">
        Our Story & Manifesto
      </span>

      <h2 class="text-3xl sm:text-5xl font-display font-bold text-charcoal">
        "Big dogs don't have personal space. <br />They have your space."
      </h2>

      <div class="space-y-4 text-neutral-600 text-base sm:text-lg leading-relaxed text-left max-w-2xl mx-auto font-normal">
        <p>
          Society looks at big dogs—Dobermans, Rottweilers, Great Danes, Mastiffs—and expects terrifying guard dogs. But anyone who lives with one knows the goofy reality:
        </p>
        <p>
          They are 40kg babies who get terrified by plastic bags blowing across the lawn, accidentally knock cups off the coffee table with happy tail thumps, and genuinely believe their 90-pound body is the size of a tea saucer.
        </p>
        <p>
          We created <strong>{BRAND_CONFIG.name}</strong> to celebrate this clumsy, affectionate lifestyle. No spikes, no scary gothic skulls—just clean, modern outdoor streetwear built for the gentlest giants on earth.
        </p>
      </div>

      <div class="pt-4">
        <a
          href="#collection"
          class="inline-flex items-center px-8 py-4 bg-charcoal hover:bg-neutral-800 text-white font-semibold text-sm uppercase tracking-wider rounded-full transition-colors shadow-sm"
        >
          Explore Drop 01 &darr;
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
