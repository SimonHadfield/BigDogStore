---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProductBySlug, PRODUCTS } from '../data/products';

const slug = Astro.url.searchParams.get('slug');
const product = slug ? getProductBySlug(slug) : PRODUCTS[0];
---

<BaseLayout
  title="Your Selection is Reserved - Canis Nobile"
  description="Return to your selected Canis Nobile garment or explore alternative sizing."
>
  <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    <span class="text-xs font-mono uppercase tracking-widest text-atelier-400 block mb-2">
      Checkout Paused
    </span>
    <h1 class="text-3xl sm:text-5xl font-editorial font-bold text-white tracking-tight mb-4">
      Your Silhouette Awaits.
    </h1>

    <p class="text-sm sm:text-base text-atelier-300 leading-relaxed max-w-xl mx-auto mb-10">
      Your checkout was not completed. We've preserved your session details. If you have questions about sizing, fabric weights, or delivery to your UK postcode, our team is at your service.
    </p>

    {product && (
      <div class="p-6 bg-atelier-900/60 border border-atelier-800 text-left flex flex-col sm:flex-row items-center gap-6 mb-10">
        <div class="w-24 h-28 flex-shrink-0 bg-atelier-850 overflow-hidden">
          <img
            src={product.images.primary}
            alt={product.title}
            width="120"
            height="150"
            class="w-full h-full object-cover grayscale"
          />
        </div>
        <div class="flex-grow">
          <span class="text-[10px] font-mono text-doberman-tan uppercase block mb-1">
            Recently Selected Garment
          </span>
          <h2 class="text-lg font-editorial font-bold text-white mb-1">
            {product.title}
          </h2>
          <p class="text-xs text-atelier-400 font-mono mb-2">
            £{product.price}.00 &middot; {product.specs.weight}
          </p>
          <a
            href={`/products/${product.slug}`}
            class="inline-block text-xs font-mono text-white underline hover:text-doberman-tan"
          >
            Resume Order for {product.title} &rarr;
          </a>
        </div>
      </div>
    )}

    <!-- Reassurance Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-left font-mono text-xs mb-10">
      <div class="p-4 bg-atelier-950 border border-atelier-850">
        <span class="text-white font-semibold block mb-1">Hassle-Free Returns</span>
        <span class="text-atelier-400 text-[11px]">30-day trial period on all unworn UK garments.</span>
      </div>
      <div class="p-4 bg-atelier-950 border border-atelier-850">
        <span class="text-white font-semibold block mb-1">Royal Mail 24</span>
        <span class="text-atelier-400 text-[11px]">Tracked and insured door-to-door delivery.</span>
      </div>
      <div class="p-4 bg-atelier-950 border border-atelier-850">
        <span class="text-white font-semibold block mb-1">Fit Advisory</span>
        <span class="text-atelier-400 text-[11px]">Reach our atelier team anytime at atelier@canisnobile.co.uk</span>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      {product && (
        <a
          href={`/products/${product.slug}`}
          class="w-full sm:w-auto px-8 py-3.5 bg-white hover:bg-doberman-bone text-atelier-950 font-mono text-xs uppercase tracking-widest font-semibold transition-all"
        >
          Complete Your Order
        </a>
      )}
      <a
        href="/"
        class="w-full sm:w-auto px-8 py-3.5 border border-atelier-750 hover:border-white text-white font-mono text-xs uppercase tracking-widest transition-all"
      >
        Explore All Garments
      </a>
    </div>
  </main>
</BaseLayout>
