---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProductBySlug, PRODUCTS } from '../data/products';
import { BRAND_CONFIG } from '../data/brand';
import HoodieMockup from '../components/HoodieMockup.astro';

const slug = Astro.url.searchParams.get('slug');
const product = slug ? getProductBySlug(slug) : PRODUCTS[0];
---

<BaseLayout
  title={`Did a 40kg Paw Distract You? | ${BRAND_CONFIG.name}`}
  description="Resume your checkout or check sizing for your Clumsy Giants apparel."
>
  <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
    
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-neutral-100 text-charcoal mb-6 shadow-sm">
      <span class="text-3xl">🐾</span>
    </div>

    <span class="px-3.5 py-1 bg-neutral-100 rounded-full text-xs font-semibold uppercase tracking-wider text-neutral-700 inline-block mb-3">
      Checkout Paused
    </span>
    <h1 class="text-3xl sm:text-5xl font-display font-bold text-charcoal tracking-tight mb-4">
      Did a 40kg Paw Distract You?
    </h1>

    <p class="text-base text-neutral-600 font-normal leading-relaxed max-w-xl mx-auto mb-8">
      We completely understand—urgent demands for belly rubs take priority over streetwear. Your piece is reserved in your size and ready whenever you are.
    </p>

    {product && (
      <div class="p-6 bg-[#F4ECE1] rounded-3xl text-left flex flex-col sm:flex-row items-center gap-6 mb-8 shadow-sm">
        <div class="w-28 h-32 flex-shrink-0">
          <HoodieMockup
            color="#1A1816"
            label="480GSM"
            badge="Reserved"
            hoodieColorName="Warm Charcoal"
            class="h-full w-full bg-white/40 border-0 shadow-none"
          />
        </div>
        <div class="flex-grow space-y-1">
          <span class="px-2.5 py-0.5 bg-white rounded-full text-[10px] font-semibold text-neutral-700 uppercase inline-block">
            Reserved In Your Size
          </span>
          <h2 class="text-lg font-display font-bold text-charcoal">
            {product.title}
          </h2>
          <p class="text-xs text-neutral-500 font-medium">
            £{product.price}.00 &bull; {product.specs.weight} &bull; UK Hand-Checked
          </p>
          <div class="pt-2">
            <a
              href={`/products/${product.slug}`}
              class="text-xs font-semibold text-rust hover:underline"
            >
              Resume Order for {product.title} &rarr;
            </a>
          </div>
        </div>
      </div>
    )}

    <div class="p-4 bg-[#FAF9F6] rounded-2xl border border-neutral-200 text-xs text-neutral-600 max-w-md mx-auto mb-8">
      💡 <strong>Need sizing reassurance?</strong> Our garments have a relaxed, dropped-shoulder fit so you have plenty of room for clumsy lapdog cuddles.
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={product ? `/products/${product.slug}` : '/shop'}
        class="w-full sm:w-auto px-8 py-3.5 bg-charcoal hover:bg-neutral-800 text-white font-semibold text-xs uppercase tracking-wider rounded-full transition-colors shadow-sm"
      >
        Complete My Order &rarr;
      </a>
      <a
        href="/shop"
        class="w-full sm:w-auto px-6 py-3.5 bg-white hover:bg-neutral-50 border border-neutral-200 text-charcoal font-semibold text-xs uppercase tracking-wider rounded-full transition-colors shadow-sm"
      >
        Browse Full Drop
      </a>
    </div>
  </main>
</BaseLayout>
