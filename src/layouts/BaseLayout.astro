---
import '@fontsource/fredoka/600.css';
import '@fontsource/fredoka/700.css';
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import { BRAND_CONFIG } from '../data/brand';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
}

const {
  title,
  description,
  image = 'https://images.unsplash.com/photo-1556905055-8f358a7a47b2?auto=format&fit=crop&w=1200&q=80',
  canonical = Astro.url.href,
} = Astro.props;

const siteName = `${BRAND_CONFIG.name} UK | Large Breed Streetwear`;
const fullTitle = `${title} | ${siteName}`;
---

<!doctype html>
<html lang="en-GB" class="scroll-smooth bg-white text-ink antialiased selection:bg-rust selection:text-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <!-- SEO Core Meta -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#1A1816" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={BRAND_CONFIG.name} />

    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />
  </head>
  <body class="flex min-h-screen flex-col bg-white text-ink font-sans">
    
    <!-- Top Announcement Bar: Full-width solid charcoal bar (#1A1816) with crisp white uppercase text and thin vertical dividers -->
    <aside aria-label="Announcement" class="bg-charcoal text-white text-[11px] sm:text-xs py-2.5 px-4 tracking-widest font-semibold uppercase">
      <div class="max-w-7xl mx-auto flex items-center justify-center space-x-3 sm:space-x-6 overflow-x-auto text-center">
        <span>FREE UK DELIVERY OVER £60</span>
        <span class="text-neutral-500 font-light" aria-hidden="true">|</span>
        <span>DESIGNED FOR LARGE BREEDS</span>
        <span class="text-neutral-500 font-light hidden sm:inline" aria-hidden="true">|</span>
        <span class="hidden sm:inline">ECO-FRIENDLY PACKAGING</span>
        <span class="text-neutral-500 font-light hidden md:inline" aria-hidden="true">|</span>
        <span class="hidden md:inline">SMALL-BATCH DROPS</span>
      </div>
    </aside>

    <!-- Main Header / Navigation: Pure White (#FFFFFF) with subtle bottom hairline border -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-neutral-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-3 items-center h-20 sm:h-24">
          
          <!-- Left Navigation Links: Shop, Our Story -->
          <nav aria-label="Main Navigation" class="flex items-center space-x-4 sm:space-x-8 text-xs sm:text-sm font-semibold text-ink">
            <a href="/shop" class="hover:text-rust transition-colors tracking-wide py-1">
              Shop
            </a>
            <a href="/shop#about" class="hover:text-rust transition-colors tracking-wide py-1">
              Our Story
            </a>
          </nav>

          <!-- Centered Chunky Retro Wordmark Logo (no dog silhouettes) -->
          <div class="flex justify-center items-center">
            <a href="/" class="focus:outline-none focus-visible:ring-2 focus-visible:ring-rust rounded-lg" aria-label="Clumsy Giants Home">
              <Logo />
            </a>
          </div>

          <!-- Right Utility Links: Size Guide, Join Waitlist pill button -->
          <div class="flex items-center justify-end space-x-3 sm:space-x-6">
            <a href="/shop#fit-guide" class="hover:text-rust text-xs sm:text-sm font-semibold transition-colors hidden md:inline-block tracking-wide">
              Size Guide
            </a>
            <a
              href="/#waitlist"
              class="inline-flex items-center justify-center px-4 sm:px-5 py-2 sm:py-2.5 text-xs sm:text-sm font-semibold tracking-wide text-white bg-charcoal hover:bg-neutral-800 rounded-full transition-all shadow-sm"
            >
              Join Waitlist
            </a>
          </div>

        </div>
      </div>
    </header>

    <!-- Page Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Clean Modern Outdoor Streetwear Footer -->
    <footer class="bg-[#FAF9F6] border-t border-neutral-200 text-ink text-sm mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
          
          <!-- Column 1: Brand Info & Wordmark -->
          <div class="space-y-4 md:col-span-2">
            <div class="flex items-center space-x-3">
              <span class="text-2xl sm:text-3xl font-display font-bold text-ink">{BRAND_CONFIG.name}</span>
              <span class="text-[10px] tracking-wider uppercase px-2 py-0.5 bg-neutral-200 text-neutral-700 rounded-full font-semibold">
                UK STREETWEAR
              </span>
            </div>
            <p class="text-ink-light max-w-sm leading-relaxed text-sm">
              Authentic streetwear for humans owned by gentle giants. Founded in the UK by Pati & Obi the Doberman. Inspired by outdoor walks, clumsy paws, zero personal space, and the lovable lapdogs who run our lives.
            </p>
            <div class="flex flex-wrap items-center gap-3 text-xs font-medium text-neutral-600 pt-1">
              <span>🐾 Large Breed Community</span>
              <span class="text-neutral-400">•</span>
              <span>🇬🇧 Hand-Checked in Leicester</span>
              <span class="text-neutral-400">•</span>
              <span>🌱 100% Plastic-Free Mailers</span>
            </div>
          </div>

          <!-- Column 2: Quick Links -->
          <div class="space-y-3">
            <h4 class="text-xs font-semibold uppercase tracking-wider text-neutral-400">Explore</h4>
            <ul class="space-y-2 text-sm text-ink-light">
              <li><a href="/shop#collection" class="hover:text-ink transition-colors">Drop 01 Apparel</a></li>
              <li><a href="/shop#about" class="hover:text-ink transition-colors">Pati & Obi's Story</a></li>
              <li><a href="/shop#fit-guide" class="hover:text-ink transition-colors">Lapdog Size Matrix</a></li>
              <li><a href="/#waitlist" class="hover:text-ink transition-colors">Drop 01 Early Access</a></li>
            </ul>
          </div>

          <!-- Column 3: Trust & Payments -->
          <div class="space-y-3">
            <h4 class="text-xs font-semibold uppercase tracking-wider text-neutral-400">Pack Support</h4>
            <p class="text-xs text-ink-light leading-relaxed">
              Official Stripe checkout with 256-bit bank encryption. Dispatch via Royal Mail Tracked 24 across the United Kingdom.
            </p>
            <div class="inline-flex items-center space-x-2 text-xs font-medium text-neutral-700 bg-white border border-neutral-200 px-3 py-1.5 rounded-full">
              <span>🔒 256-Bit Stripe UK Checkout</span>
            </div>
            <p class="text-xs text-ink-light pt-1">
              Questions? Say hello at <a href={`mailto:${BRAND_CONFIG.contactEmail}`} class="text-ink font-semibold hover:underline">{BRAND_CONFIG.contactEmail}</a>
            </p>
          </div>
        </div>

        <div class="border-t border-neutral-200 mt-12 pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-neutral-500 gap-4">
          <p>&copy; {new Date().getFullYear()} {BRAND_CONFIG.name} Ltd. Built for large breed dogs and the people who love them.</p>
          <div class="flex space-x-6">
            <span class="hover:text-ink cursor-pointer">Terms of Service</span>
            <span class="hover:text-ink cursor-pointer">Privacy Policy</span>
            <span class="hover:text-ink cursor-pointer">UK Shipping & Returns</span>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
