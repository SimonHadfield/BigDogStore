---
import '@fontsource/fraunces/400.css';
import '@fontsource/fraunces/600.css';
import '@fontsource/fraunces/700.css';
import '@fontsource/fraunces/400-italic.css';
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import { BRAND_CONFIG } from '../data/brand';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
}

const {
  title,
  description,
  image = 'https://images.unsplash.com/photo-1556905055-8f358a7a47b2?auto=format&fit=crop&w=1200&q=80',
  canonical = Astro.url.href,
} = Astro.props;

const siteName = `${BRAND_CONFIG.name} UK | Casual Streetwear for Big Dog Owners`;
const fullTitle = `${title} | ${siteName}`;
---

<!doctype html>
<html lang="en-GB" class="scroll-smooth bg-cream-100 text-espresso antialiased selection:bg-tan selection:text-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <!-- SEO Core Meta -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#FAF6F0" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={BRAND_CONFIG.name} />

    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />
  </head>
  <body class="flex min-h-screen flex-col bg-cream-100 text-espresso font-sans">
    
    <!-- Top Announcement Bar: Relatable & Trust building -->
    <aside aria-label="Announcement" class="bg-espresso text-cream-100 text-xs py-2.5 px-4 text-center tracking-wide font-medium border-b border-espresso-800">
      <div class="max-w-7xl mx-auto flex items-center justify-center space-x-2">
        <span class="inline-block w-2 h-2 rounded-full bg-tan animate-pulse"></span>
        <span>
          <strong>Free UK Delivery on orders over £70</strong> &bull; Hand-checked in small batches &bull; 100% Dog-Hair Friendly Loopback Cotton
        </span>
      </div>
    </aside>

    <!-- Header / Navigation -->
    <header class="sticky top-0 z-50 bg-cream-100/90 backdrop-blur-md border-b border-sand-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
          
          <!-- Brand Wordmark -->
          <a href="/" class="group flex items-center space-x-2 text-espresso hover:opacity-90 transition-opacity">
            <span class="text-2xl sm:text-3xl font-display font-bold tracking-tight text-espresso">
              {BRAND_CONFIG.name}
            </span>
            <span class="inline-block px-2 py-0.5 text-[11px] font-bold uppercase tracking-wider bg-tan text-white rounded-full">
              Club
            </span>
          </a>

          <!-- Nav Items -->
          <nav aria-label="Main Navigation" class="hidden md:flex items-center space-x-8 text-sm font-semibold text-espresso-700">
            <a href="/#collection" class="hover:text-tan transition-colors">The Drop</a>
            <a href="/#fit-guide" class="hover:text-tan transition-colors">Sizing Matrix</a>
            <a href="/#about" class="hover:text-tan transition-colors">Why Big Dogs?</a>
            <a href="/#batch-info" class="hover:text-tan transition-colors">Batch Quality</a>
          </nav>

          <!-- Right Call to Action -->
          <div class="flex items-center space-x-4">
            <a
              href="/#collection"
              class="inline-flex items-center justify-center px-4 py-2 text-xs sm:text-sm font-bold uppercase tracking-wider text-white bg-tan hover:bg-tan-dark rounded-full transition-all shadow-sm hover:shadow-md active:scale-95"
            >
              Shop The Drop
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Page Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Warm, Playful Footer -->
    <footer class="bg-sand-100 border-t border-sand-200 text-espresso-700 text-sm mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
          
          <!-- Column 1: Brand Info -->
          <div class="space-y-4 md:col-span-2">
            <div class="flex items-center space-x-2">
              <span class="text-2xl font-display font-bold text-espresso">{BRAND_CONFIG.name}</span>
              <span class="text-xs px-2 py-0.5 bg-sage text-white rounded-full font-bold">UK</span>
            </div>
            <p class="text-espresso-600 max-w-sm leading-relaxed">
              Streetwear inspired by clumsy 40kg lapdogs, couch hogs, and gentle giants who think they can hide behind lampposts. Designed with love and heavy cotton in the United Kingdom.
            </p>
            <div class="flex items-center space-x-4 text-xs font-semibold text-espresso-600 pt-2">
              <span class="flex items-center gap-1.5">
                <span class="text-base">🐾</span> Tested by real lap-dogs
              </span>
              <span class="flex items-center gap-1.5">
                <span class="text-base">🇬🇧</span> Small-batch UK prints
              </span>
            </div>
          </div>

          <!-- Column 2: Quick Links -->
          <div class="space-y-3">
            <h4 class="text-xs font-bold uppercase tracking-wider text-espresso">Navigation</h4>
            <ul class="space-y-2 text-sm text-espresso-600">
              <li><a href="/#collection" class="hover:text-tan transition-colors">Current Drop</a></li>
              <li><a href="/#fit-guide" class="hover:text-tan transition-colors">Sizing Matrix (S–XXL)</a></li>
              <li><a href="/#about" class="hover:text-tan transition-colors">The Velcro Dog Manifesto</a></li>
              <li><a href="/#batch-info" class="hover:text-tan transition-colors">Small-Batch Quality Check</a></li>
            </ul>
          </div>

          <!-- Column 3: Trust & Payments -->
          <div class="space-y-3">
            <h4 class="text-xs font-bold uppercase tracking-wider text-espresso">Checkout & Support</h4>
            <p class="text-xs text-espresso-600 leading-relaxed">
              Bank-grade 256-bit SSL encryption via Stripe. Exclusive Royal Mail Tracked 24 fulfillment across the United Kingdom.
            </p>
            <div class="inline-flex items-center space-x-2 px-3 py-1 bg-white border border-sand-200 rounded-lg text-xs font-semibold text-espresso">
              <span>🔒 Direct UK Stripe Checkout</span>
            </div>
            <p class="text-xs text-espresso-500 pt-2">
              Questions? Say hi at <a href={`mailto:${BRAND_CONFIG.contactEmail}`} class="underline hover:text-tan">{BRAND_CONFIG.contactEmail}</a>
            </p>
          </div>
        </div>

        <div class="border-t border-sand-200 mt-12 pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-espresso-500 gap-4">
          <p>&copy; {new Date().getFullYear()} {BRAND_CONFIG.name} Ltd. All paws reserved. Registered in the UK.</p>
          <div class="flex space-x-6">
            <span class="hover:text-espresso transition-colors">Terms of Service</span>
            <span class="hover:text-espresso transition-colors">Privacy Policy</span>
            <span class="hover:text-espresso transition-colors">UK Returns & Exchanges</span>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
