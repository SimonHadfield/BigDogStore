---
// TODO: Swap in final transparent logo PNG/SVG from Pati once created
// e.g. <img src="/src/assets/logo.svg" alt="Clumsy Giants" class="h-10 w-auto" />

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`inline-flex flex-col items-center justify-center text-center group ${className}`}>
  <!-- Chunky, bouncy rounded wordmark using @fontsource/fredoka 700 with tight letter-spacing -->
  <!-- Note: No Doberman silhouettes inside the text logo per founder feedback -->
  <span class="text-2xl sm:text-3xl lg:text-4xl font-display font-bold text-ink tracking-tight leading-none group-hover:text-rust transition-colors select-none">
    Clumsy Giants
  </span>
  <span class="text-[9px] sm:text-[10px] font-sans font-extrabold uppercase tracking-[0.25em] text-ink/75 mt-1 select-none">
    — LARGE BREED STREETWEAR —
  </span>
</div>
