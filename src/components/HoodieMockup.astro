---
// TODO: Drop transparent hoodie PNGs (e.g. dog-mom-club-hoodie.png) into src/assets/products/
// When an asset is available, pass the image path via imageSrc prop or drop it into src/assets/products/dog-mom-club-hoodie.png

interface Props {
  color?: string; // hex fallback
  label?: string;
  badge?: string;
  hoodieColorName?: string;
  imageSrc?: string;
  class?: string;
}

const {
  color = '#1A1816',
  label = '480GSM Heavyweight Loopback',
  badge = 'Drop 01 Exclusive',
  hoodieColorName = 'Warm Charcoal',
  imageSrc,
  class: className = '',
} = Astro.props;
---

<div class={`relative aspect-[4/5] bg-[#F7F3EC] rounded-2xl p-6 flex flex-col justify-between overflow-hidden border border-neutral-200/60 ${className}`}>
  <!-- Subtle ambient gradient background -->
  <div class="absolute inset-0 bg-gradient-to-b from-white/40 to-transparent pointer-events-none"></div>

  <!-- Top Mockup Badge Bar -->
  <div class="relative z-10 flex items-center justify-between">
    <span class="px-3 py-1 bg-charcoal text-white font-medium text-[11px] rounded-full tracking-wide">
      {badge}
    </span>
    <span class="px-2.5 py-0.5 bg-white/90 border border-neutral-200 rounded-full text-[10px] font-mono font-semibold text-neutral-700 shadow-sm">
      480 GSM
    </span>
  </div>

  <!-- Center: Transparent Hoodie PNG or Graceful Vector Fallback Mockup -->
  <div class="relative z-10 my-auto flex flex-col items-center justify-center py-4">
    {imageSrc ? (
      <img
        src={imageSrc}
        alt={`${hoodieColorName} Hoodie`}
        class="max-h-56 w-auto object-contain transition-transform hover:scale-105 duration-300 drop-shadow-md"
      />
    ) : (
      <!-- Graceful Styled Mockup Fallback -->
      <div class="relative w-44 h-48 sm:w-52 sm:h-56 transition-transform hover:scale-105 duration-300 drop-shadow-md">
        <svg viewBox="0 0 200 220" class="w-full h-full">
          <!-- Hoodie Body -->
          <path
            d="M 50 70 L 25 105 L 45 125 L 55 105 L 55 195 L 145 195 L 145 105 L 155 125 L 175 105 L 150 70 L 130 50 C 130 65 70 65 70 50 Z"
            fill={color}
            stroke="#1A1816"
            stroke-width="1.5"
            stroke-linejoin="round"
          />
          <!-- Hood Cross Detail -->
          <path
            d="M 70 50 C 70 20 130 20 130 50 C 120 70 80 70 70 50 Z"
            fill={color}
            stroke="#1A1816"
            stroke-width="1.5"
          />
          <!-- Kangaroo Pocket Outline -->
          <path
            d="M 68 140 L 132 140 L 140 185 L 60 185 Z"
            fill="none"
            stroke="rgba(255,255,255,0.22)"
            stroke-width="1.5"
          />
          <!-- Drawstrings -->
          <path
            d="M 90 60 L 88 105 M 110 60 L 112 105"
            stroke="rgba(255,255,255,0.4)"
            stroke-width="2"
            stroke-linecap="round"
          />
          <!-- Minimal Brand Chest Stamp (Clean line) -->
          <text
            x="100"
            y="94"
            text-anchor="middle"
            fill="rgba(255,255,255,0.85)"
            font-size="8"
            font-family="sans-serif"
            font-weight="700"
            letter-spacing="1"
          >
            CLUMSY GIANTS
          </text>
        </svg>
      </div>
    )}
  </div>

  <!-- Bottom Spec Label -->
  <div class="relative z-10 flex items-center justify-between text-xs font-medium text-neutral-600 pt-2 border-t border-neutral-200/50">
    <span class="truncate">{hoodieColorName}</span>
    <span class="text-[10px] uppercase tracking-wider text-neutral-500 font-mono">Loopback Terry</span>
  </div>
</div>
